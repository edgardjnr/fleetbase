# Context for console/Dockerfile (build context = repository root).
# BuildKit uses this file instead of the root .dockerignore for that Dockerfile.

# everything except the console and the frontend packages it links to
*
!console
!packages/customer-portal
!packages/dev-engine
!packages/ember-core
!packages/ember-ui
!packages/fleetops
!packages/fleetops-data
!packages/iam-engine

# never send local installs/builds or secrets
**/node_modules
**/dist
**/tmp
**/.git
**/.env
**/.env.*
!console/environments/.env.production
!console/environments/.env.development
packages/*/server
packages/*/tests
