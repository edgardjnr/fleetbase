<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container pt-0i text-gray-900 dark:text-white">
        {{#if @options.isOwner}}
            {{#if @options.hasOtherMembers}}
                <p>
                    <div class="text-base mb-2">
                        {{t "console.ui.modals.leave-organization.owner-intro" name=@options.organization.name htmlSafe=true}}
                    </div>
                    <div>{{t "console.ui.modals.leave-organization.select-member-help"}}</div>
                </p>
                <InputGroup @name={{t "console.ui.modals.leave-organization.select-new-owner"}} @wrapperClass="mt-2 mb-0i">
                    <Select
                        @options={{@options.organization.users}}
                        @value={{@options.newOwnerId}}
                        @onSelect={{@options.selectNewOwner}}
                        @optionLabel="name"
                        @optionValue="id"
                        @placeholder={{t "console.ui.modals.leave-organization.select-member"}}
                    />
                </InputGroup>
            {{else if @options.willBeDeleted}}
                <p>
                    <div class="text-base mb-2">
                        {{t "console.ui.modals.leave-organization.sole-owner" name=@options.organization.name htmlSafe=true}}
                    </div>
                    <div>{{t "console.ui.modals.leave-organization.will-be-deleted"}}</div>
                    <div>{{t "console.ui.modals.leave-organization.proceed-question"}}</div>
                </p>
                <p class="mt-3"><em>{{t "console.ui.modals.leave-organization.cannot-undo"}}</em></p>
            {{/if}}
        {{else}}
            <p>
                <div class="text-base mb-2">
                    {{t "console.ui.modals.leave-organization.leave-question" name=@options.organization.name htmlSafe=true}}
                </div>
                <div>{{t "console.ui.modals.leave-organization.lose-access"}}</div>
            </p>
        {{/if}}
    </div>
</Modal::Default>