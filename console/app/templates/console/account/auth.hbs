{{page-title (t "console.ui.account.auth.title")}}
<Layout::Section::Header @title={{t "console.ui.account.auth.title"}} />

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">
            <ContentPanel @title={{t "console.ui.account.auth.change-email"}} @open={{true}} @wrapperClass="bordered-classic">
                <form id="change-email-form" aria-label="change-email" {{on "submit" (perform this.changeEmail)}}>
                    <legend class="mb-3">{{t "console.ui.account.auth.change-email"}}</legend>
                    <p class="text-sm text-gray-700 dark:text-gray-300 mb-4">
                        {{t "console.ui.account.auth.change-email-help"}}
                    </p>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2">
                        <InputGroup @name={{t "console.ui.account.auth.current-email"}} @type="email" @value={{this.currentUser.user.email}} @disabled={{true}} />
                        <InputGroup @name={{t "console.ui.account.auth.new-email"}} @type="email" @value={{this.newEmail}} />
                        <InputGroup @name={{t "console.ui.account.auth.current-password"}} @type="password" @value={{this.currentPassword}} @wrapperClass="lg:col-span-2" />
                    </div>
                    <div class="mt-3">
                        <Button
                            @type="primary"
                            @buttonType="submit"
                            @text={{t "console.ui.account.auth.send-verification-email"}}
                            @icon="envelope"
                            @disabled={{not (and this.newEmail this.currentPassword)}}
                            @isLoading={{this.changeEmail.isRunning}}
                            {{on "click" (perform this.changeEmail)}}
                        />
                    </div>
                </form>
            </ContentPanel>

            <ContentPanel @title={{t "common.change-password"}} @open={{true}} @wrapperClass="bordered-classic">
                <form id="change-password-form" aria-label="change-password" {{on "submit" (perform this.changePassword)}}>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <InputGroup @name={{t "console.ui.account.auth.enter-new-password"}} @type="password" @value={{this.newPassword}} />
                        <InputGroup @name={{t "common.confirm-password"}} @type="password" @value={{this.newConfirmPassword}} />
                    </div>
                    <div class="mt-3">
                        <Button @type="primary" @buttonType="submit" @text={{t "console.ui.account.auth.confirm-change-password"}} @icon="save" @disabled={{not (and this.newPassword this.newConfirmPassword)}} {{on "click" (perform this.changePassword)}} />
                    </div>
                </form>
            </ContentPanel>

            {{#if this.isSystemTwoFaEnabled}}
                <ContentPanel @title={{t "console.ui.account.auth.two-fa-settings"}} @open={{true}} @wrapperClass="bordered-classic">
                    <div class="mb-3">
                        {{#if this.loadUserTwoFaSettings.isIdle}}
                            <TwoFaSettings
                                @twoFaMethods={{this.methods}}
                                @twoFaSettings={{this.twoFaSettings}}
                                @onTwoFaToggled={{this.onTwoFaToggled}}
                                @onTwoFaMethodSelected={{this.onTwoFaMethodSelected}}
                            />
                        {{else}}
                            <div class="flex items-center justify-center p-4">
                                <Spinner @loadingMessage={{t "console.ui.account.auth.loading-two-fa"}} @wrapperClass="flex flex-row" @iconClass="mr-2" />
                            </div>
                        {{/if}}
                    </div>
                    <Button
                        @type="primary"
                        @buttonType="submit"
                        @text={{t "console.ui.account.auth.save-two-fa"}}
                        @icon="save"
                        @onClick={{this.saveTwoFactorAuthSettings}}
                        @isLoading={{this.saveUserTwoFaSettings.isRunning}}
                    />
                </ContentPanel>
            {{/if}}
        </div>
    </div>
    <Spacer @height="500px" />
</Layout::Section::Body>