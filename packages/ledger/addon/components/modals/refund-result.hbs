<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <div class="mb-4 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800 dark:border-green-700 dark:bg-green-900 dark:text-green-100">
            <div class="font-semibold">{{this.statusTitle}}</div>
            <div class="mt-1">{{this.statusMessage}}</div>
        </div>

        <InputGroup @name={{t "ledger.ui.refund.customer-link"}} @helpText={{t "ledger.ui.refund.customer-link-help"}}>
            <div class="flex min-w-0 items-center justify-between gap-3 rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-800">
                <ClickToCopy @value={{@options.refundUrl}} class="min-w-0 flex-1">
                    <a href={{@options.refundUrl}} target="_blank" rel="noopener noreferrer" class="block truncate font-mono text-xs text-blue-600 hover:underline dark:text-blue-400">
                        {{@options.refundUrl}}
                    </a>
                </ClickToCopy>
                <ClickToCopy @value={{@options.refundUrl}} class="flex-shrink-0">
                    <span class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">{{t "ledger.ui.refund.copy"}}</span>
                </ClickToCopy>
            </div>
        </InputGroup>

        {{#if @options.talerRefundUri}}
            <InputGroup @name={{t "ledger.ui.refund.wallet-uri"}} @helpText={{t "ledger.ui.refund.wallet-uri-help"}}>
                <div class="flex min-w-0 items-center justify-between gap-3 rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-800">
                    <ClickToCopy @value={{@options.talerRefundUri}} class="min-w-0 flex-1">
                        <span class="block truncate font-mono text-xs text-gray-600 dark:text-gray-300">{{@options.talerRefundUri}}</span>
                    </ClickToCopy>
                    <ClickToCopy @value={{@options.talerRefundUri}} class="flex-shrink-0">
                        <span class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">{{t "ledger.ui.refund.copy"}}</span>
                    </ClickToCopy>
                </div>
            </InputGroup>
        {{/if}}

        <InputGroup @name={{t "ledger.ui.refund.customer-email"}} @helpText={{t "ledger.ui.refund.customer-email-result-help"}}>
            <div class="flex items-center gap-2">
                <Input @value={{this.email}} @type="email" class="form-input w-full" placeholder="customer@example.com" {{on "input" this.setEmail}} />
                <Button class="whitespace-nowrap" @icon="paper-plane" @text={{t "ledger.ui.refund.send-email"}} @size="sm" @type="default" @onClick={{this.sendRefundUri}} />
            </div>
        </InputGroup>

        <div class="grid grid-cols-2 gap-3">
            <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700">
                <div class="text-xs text-gray-500">{{t "ledger.ui.refund.refund-status"}}</div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">{{n-a @options.refundStatus}}</div>
            </div>
            <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700">
                <div class="text-xs text-gray-500">{{t "ledger.ui.refund.wallet-status"}}</div>
                <div class="text-sm font-semibold text-gray-900 dark:text-white">{{n-a @options.walletStatus}}</div>
            </div>
        </div>

        <div class="mt-3 text-xs text-gray-500">
            {{t "ledger.ui.refund.gateway-refund-transaction"}}
            {{n-a @options.gatewayTransactionId}}
        </div>
    </div>
</Modal::Default>
