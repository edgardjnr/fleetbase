<div class="details-wrapper" ...attributes>
    {{! TRANSACTION DETAILS }}
    <ContentPanel @title={{t "ledger.ui.transaction.details-title"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "ledger.ui.transaction.information"}}
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.reference-id"}}</div>
                <div class="field-value font-mono">{{n-a @resource.public_id}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.payments.field.status"}}</div>
                <div class="field-value">
                    <Badge @status={{@resource.status}} @color={{@resource.status_badge_color}}>{{@resource.status}}</Badge>
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.payments.field.type"}}</div>
                <div class="field-value capitalize">{{n-a @resource.type}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.direction"}}</div>
                <div class="field-value capitalize">{{n-a @resource.direction}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.gateway"}}</div>
                <div class="field-value">{{n-a @resource.gateway}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.gateway-transaction-id"}}</div>
                <div class="field-value font-mono">{{n-a @resource.gateway_transaction_id}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.payment-method"}}</div>
                <div class="field-value capitalize">{{n-a @resource.payment_method}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.card"}}</div>
                <div class="field-value">
                    {{#if @resource.payment_method_brand}}
                        {{@resource.payment_method_brand}}
                        ····
                        {{@resource.payment_method_last4}}
                    {{else}}
                        {{n-a null}}
                    {{/if}}
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.reference"}}</div>
                <div class="field-value font-mono">{{n-a @resource.reference}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.date"}}</div>
                <div class="field-value">{{n-a @resource.createdAt}}</div>
            </div>

            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "ledger.ui.payments.field.amounts"}}
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.payments.field.amount"}}</div>
                <div class="field-value font-semibold">{{format-currency @resource.amount @resource.currency}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.payments.field.currency"}}</div>
                <div class="field-value">{{n-a @resource.currency}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.fee"}}</div>
                <div class="field-value">{{format-currency @resource.fee @resource.currency}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.tax"}}</div>
                <div class="field-value">{{format-currency @resource.tax @resource.currency}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.net-amount"}}</div>
                <div class="field-value font-semibold">{{format-currency @resource.net @resource.currency}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.balance-after"}}</div>
                <div class="field-value">{{format-currency @resource.balance_after @resource.currency}}</div>
            </div>

            {{#if @resource.exchange_rate}}
                <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                    {{t "ledger.ui.transaction.settlement"}}
                </div>

                <div class="field-info-container">
                    <div class="field-name">{{t "ledger.ui.transaction.exchange-rate"}}</div>
                    <div class="field-value">{{n-a @resource.exchange_rate}}</div>
                </div>

                <div class="field-info-container">
                    <div class="field-name">{{t "ledger.ui.transaction.settled-currency"}}</div>
                    <div class="field-value">{{n-a @resource.settled_currency}}</div>
                </div>

                <div class="field-info-container">
                    <div class="field-name">{{t "ledger.ui.transaction.settled-amount"}}</div>
                    <div class="field-value">{{format-currency @resource.settled_amount @resource.settled_currency}}</div>
                </div>

                <div class="field-info-container">
                    <div class="field-name">{{t "ledger.ui.transaction.settled-at"}}</div>
                    <div class="field-value">{{n-a @resource.settledAt}}</div>
                </div>
            {{/if}}

        </div>
    </ContentPanel>

    {{! PARTIES }}
    <ContentPanel @title={{t "ledger.ui.transaction.parties"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.payer"}}</div>
                <div class="field-value">{{n-a @resource.payer_name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.payee"}}</div>
                <div class="field-value">{{n-a @resource.payee_name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.initiated-by"}}</div>
                <div class="field-value">{{n-a @resource.initiator_name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.transaction.ip-address"}}</div>
                <div class="field-value font-mono">{{n-a @resource.ip_address}}</div>
            </div>

        </div>
    </ContentPanel>

    {{! FAILURE INFO }}
    {{#if @resource.failure_reason}}
        <ContentPanel @title={{t "ledger.ui.transaction.failure-information"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

                <div class="field-info-container">
                    <div class="field-name">{{t "ledger.ui.transaction.failure-code"}}</div>
                    <div class="field-value font-mono text-red-600">{{n-a @resource.failure_code}}</div>
                </div>

                <div class="field-info-container col-span-2">
                    <div class="field-name">{{t "ledger.ui.transaction.failure-reason"}}</div>
                    <div class="field-value text-red-600">{{n-a @resource.failure_reason}}</div>
                </div>

            </div>
        </ContentPanel>
    {{/if}}

    {{! DESCRIPTION & NOTES }}
    {{#if (or @resource.description @resource.notes)}}
        <ContentPanel @title={{t "ledger.ui.payments.field.description-notes"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 gap-2 text-xs dark:text-gray-100">

                {{#if @resource.description}}
                    <div class="field-info-container">
                        <div class="field-name">{{t "ledger.ui.payments.field.description"}}</div>
                        <div class="field-value">{{@resource.description}}</div>
                    </div>
                {{/if}}

                {{#if @resource.notes}}
                    <div class="field-info-container">
                        <div class="field-name">{{t "ledger.ui.payments.field.notes"}}</div>
                        <div class="field-value">{{@resource.notes}}</div>
                    </div>
                {{/if}}

            </div>
        </ContentPanel>
    {{/if}}

    {{! RECORD INFO }}
    <ContentPanel @title={{t "ledger.ui.payments.field.record-info"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.payments.field.created"}}</div>
                <div class="field-value">{{n-a @resource.createdAt}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.ui.payments.field.last-updated"}}</div>
                <div class="field-value">{{n-a @resource.updatedAt}}</div>
            </div>

        </div>
    </ContentPanel>
    <Spacer @height="200px" />
</div>