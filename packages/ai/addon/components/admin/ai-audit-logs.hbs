<ContentPanel @title={{t "ai.ui.audit-logs.title"}} @open={{true}} @wrapperClass="bordered-classic">
    <div class="fleetbase-ai-admin-panel">
        <div class="fleetbase-ai-admin-filters">
            <InputGroup @name={{t "ai.ui.common.search"}}>
                <Input class="form-input form-input-sm w-full" @value={{this.filters.search}} placeholder={{t "ai.ui.audit-logs.search-placeholder"}} {{on "input" (fn this.setFilterFromInput "search")}} />
            </InputGroup>
            <InputGroup @name={{t "ai.ui.common.status"}}>
                <Select class="w-full" @value={{this.filters.status}} @options={{this.statusOptions}} @optionLabel="label" @optionValue="value" @onSelect={{fn this.setFilter "status"}} />
            </InputGroup>
            <InputGroup @name={{t "ai.ui.common.provider"}}>
                <Select class="w-full" @value={{this.filters.provider}} @options={{this.providerOptions}} @optionLabel="label" @optionValue="value" @placeholder={{t "ai.ui.common.any-provider"}} @onSelect={{this.setProvider}} />
            </InputGroup>
            <InputGroup @name={{t "ai.ui.common.model"}}>
                <Select class="w-full" @value={{this.filters.model}} @options={{this.modelOptions}} @optionLabel="label" @optionValue="value" @placeholder={{t "ai.ui.common.any-model"}} @onSelect={{fn this.setFilter "model"}} />
            </InputGroup>
            <InputGroup @name={{t "ai.ui.common.organization"}}>
                <ModelSelect
                    @modelName="company"
                    @source={{this.companySource}}
                    @selectedModel={{this.selectedCompany}}
                    @placeholder={{t "ai.ui.common.select-organization"}}
                    @triggerClass="form-select form-input"
                    @allowClear={{true}}
                    @renderInPlace={{true}}
                    @onChange={{this.setCompany}}
                    as |company|
                >
                    {{or company.name company.public_id company.uuid}}
                </ModelSelect>
            </InputGroup>
            <InputGroup @name={{t "ai.ui.common.user"}}>
                <ModelSelect
                    @modelName="user"
                    @source={{this.userSource}}
                    @query={{this.userQuery}}
                    @selectedModel={{this.selectedUser}}
                    @placeholder={{t "ai.ui.common.select-user"}}
                    @triggerClass="form-select form-input"
                    @allowClear={{true}}
                    @renderInPlace={{true}}
                    @onChange={{this.setUser}}
                    as |user|
                >
                    {{or user.name user.email user.public_id user.uuid}}
                </ModelSelect>
            </InputGroup>
            <InputGroup @name={{t "ai.ui.common.date"}}>
                <DatePicker @value={{this.dateRange}} @range={{true}} @onSelect={{this.setDateRange}} @autoClose={{true}} @buttons={{array "clear"}} @placeholder={{t "ai.ui.common.date-placeholder"}} class="w-full form-input-sm" />
            </InputGroup>
        </div>

        <div class="fleetbase-ai-admin-actions">
            <Button @type="primary" @icon="magnifying-glass" @text={{t "ai.ui.audit-logs.search-logs"}} @isLoading={{this.loadSessions.isRunning}} @onClick={{perform this.loadSessions}} />
            <Button @icon="xmark" @text={{t "ai.ui.common.clear"}} @onClick={{this.clearFilters}} />
        </div>

        <div class="fleetbase-ai-admin-stack">
            <div class="fleetbase-ai-admin-card">
                <div class="fleetbase-ai-admin-card-header">
                    <span>{{t "ai.ui.audit-logs.chat-sessions"}}</span>
                    <small>{{t "ai.ui.audit-logs.shown" count=this.sessions.length}}</small>
                </div>

                <div class="fleetbase-ai-admin-table-wrap fleetbase-ai-admin-scroll-area">
                    <table class="fleetbase-ai-admin-table">
                        <thead>
                            <tr>
                                <th>{{t "ai.ui.common.title"}}</th>
                                <th>{{t "ai.ui.common.organization"}}</th>
                                <th>{{t "ai.ui.common.user"}}</th>
                                <th>{{t "ai.ui.common.status"}}</th>
                                <th>{{t "ai.ui.audit-logs.turns"}}</th>
                                <th>{{t "ai.ui.common.tokens"}}</th>
                                <th>{{t "ai.ui.audit-logs.last-message"}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each this.sessions as |session|}}
                                <tr role="button" class="fleetbase-ai-admin-row" {{on "click" (fn this.selectSession session)}}>
                                    <td>
                                        <strong>{{or session.title (t "ai.ui.common.new-chat")}}</strong>
                                        <small>{{session.uuid}}</small>
                                    </td>
                                    <td>{{or session.company.name session.company_uuid (t "ai.ui.common.unknown")}}</td>
                                    <td>{{or session.created_by.name session.created_by.email session.created_by_uuid (t "ai.ui.common.unknown")}}</td>
                                    <td><span class="fleetbase-ai-admin-badge">{{or session.status (t "ai.ui.common.unknown-lower")}}</span></td>
                                    <td>{{session.tasks_count}}</td>
                                    <td>{{session.total_tokens}}</td>
                                    <td>{{n-a (format-date-fns session.last_message_at "dd MMM yyyy HH:mm")}}</td>
                                </tr>
                            {{else}}
                                <tr>
                                    <td colspan="7" class="fleetbase-ai-admin-empty">{{t "ai.ui.audit-logs.no-sessions"}}</td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="fleetbase-ai-admin-card">
                <div class="fleetbase-ai-admin-card-header">
                    <span>{{t "ai.ui.audit-logs.session-tasks"}}</span>
                    {{#if this.selectedSession}}
                        <small>{{t "ai.ui.audit-logs.turns-count" count=this.selectedSessionTasks.length}}</small>
                    {{/if}}
                </div>

                {{#if this.selectedSession}}
                    <div class="fleetbase-ai-admin-task-list">
                        {{#each this.selectedSessionTasks as |task|}}
                            <button type="button" class="fleetbase-ai-admin-task-item" {{on "click" (fn this.selectTask task)}}>
                                <span>
                                    <strong>{{or task.prompt_excerpt (t "ai.ui.audit-logs.untitled-prompt")}}</strong>
                                    <small>{{or task.response_summary (t "ai.ui.audit-logs.no-response-summary")}} </small>
                                </span>
                                <span class="fleetbase-ai-admin-task-meta">
                                    {{or task.provider "local"}} / {{or task.model (t "ai.ui.common.unknown-lower")}}
                                    <b>{{task.total_tokens}}</b>
                                </span>
                            </button>
                        {{else}}
                            <div class="fleetbase-ai-admin-empty">{{t "ai.ui.audit-logs.no-tasks"}}</div>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="fleetbase-ai-admin-empty">{{t "ai.ui.audit-logs.select-session"}}</div>
                {{/if}}
            </div>
        </div>

        <div class="fleetbase-ai-admin-card">
            <div class="fleetbase-ai-admin-card-header">
                <span>{{t "ai.ui.audit-logs.task-detail"}}</span>
                {{#if this.selectedTask}}
                    <small>{{this.selectedTask.uuid}}</small>
                {{/if}}
            </div>

            {{#if this.selectedTask}}
                <div class="fleetbase-ai-admin-detail-grid">
                    <div><label>{{t "ai.ui.common.status"}}</label><span>{{or this.selectedTask.status (t "ai.ui.common.unknown-lower")}}</span></div>
                    <div><label>{{t "ai.ui.common.provider"}}</label><span>{{or this.selectedTask.provider "local"}}</span></div>
                    <div><label>{{t "ai.ui.common.model"}}</label><span>{{or this.selectedTask.model (t "ai.ui.common.unknown-lower")}}</span></div>
                    <div><label>{{t "ai.ui.common.total-tokens"}}</label><span>{{this.selectedTask.total_tokens}}</span></div>
                    <div><label>{{t "ai.ui.audit-logs.created"}}</label><span>{{n-a (format-date-fns this.selectedTask.created_at "dd MMM yyyy HH:mm")}}</span></div>
                    <div><label>{{t "ai.ui.audit-logs.completed"}}</label><span>{{n-a (format-date-fns this.selectedTask.completed_at "dd MMM yyyy HH:mm")}}</span></div>
                </div>

                {{#if this.hasSelectedTaskContent}}
                    <div class="fleetbase-ai-admin-content-grid">
                        <div>
                            <h4>{{t "ai.ui.audit-logs.prompt"}}</h4>
                            <pre>{{this.selectedTask.prompt}}</pre>
                        </div>
                        <div>
                            <h4>{{t "ai.ui.audit-logs.response"}}</h4>
                            <pre>{{this.selectedTask.response}}</pre>
                        </div>
                    </div>
                {{else}}
                    <div class="fleetbase-ai-admin-redacted">
                        <span>{{t "ai.ui.audit-logs.content-redacted"}}</span>
                        {{#if this.canRevealContent}}
                            <Button @icon="eye" @text={{t "ai.ui.audit-logs.reveal-content"}} @size="sm" @isLoading={{this.revealTaskContent.isRunning}} @onClick={{perform this.revealTaskContent}} />
                        {{/if}}
                    </div>
                {{/if}}

                <div class="fleetbase-ai-admin-table-wrap mt-3">
                    <table class="fleetbase-ai-admin-table">
                        <thead>
                            <tr>
                                <th>{{t "ai.ui.audit-logs.step"}}</th>
                                <th>{{t "ai.ui.common.status"}}</th>
                                <th>{{t "ai.ui.audit-logs.tool"}}</th>
                                <th>{{t "ai.ui.common.provider"}}</th>
                                <th>{{t "ai.ui.common.tokens"}}</th>
                                <th>{{t "ai.ui.audit-logs.created"}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each this.selectedTaskSteps as |step|}}
                                <tr>
                                    <td>{{or step.type (t "ai.ui.audit-logs.step-lower")}}</td>
                                    <td>{{or step.status (t "ai.ui.common.unknown-lower")}}</td>
                                    <td>{{n-a step.tool}}</td>
                                    <td>{{or step.provider this.selectedTask.provider "local"}}</td>
                                    <td>{{or step.usage.total_tokens "-"}}</td>
                                    <td>{{n-a (format-date-fns step.created_at "dd MMM HH:mm")}}</td>
                                </tr>
                            {{else}}
                                <tr>
                                    <td colspan="6" class="fleetbase-ai-admin-empty">{{t "ai.ui.audit-logs.no-steps"}}</td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <div class="fleetbase-ai-admin-empty">{{t "ai.ui.audit-logs.select-task"}}</div>
            {{/if}}
        </div>
    </div>
</ContentPanel>
