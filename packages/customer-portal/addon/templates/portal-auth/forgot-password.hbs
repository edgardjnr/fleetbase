<div class="bg-white dark:bg-gray-800 py-8 px-4 shadow rounded-lg">
    <div class="mb-4">
        <LinkTo @route="portal" class="flex items-center justify-center">
            <LogoIcon @size="12" class="rounded-md" />
        </LinkTo>
        <h2 class="text-center text-lg font-extrabold text-gray-900 dark:text-white truncate">
            {{if this.isSent (t "customer-portal.ui.auth.forgot-password.sent-title") (t "customer-portal.ui.auth.forgot-password.title")}}
        </h2>
    </div>

    {{#if this.isSent}}
        <InfoBlock @type="success" @icon="info-circle" @iconSize="lg" @iconClass="mt-1" class="my-6">
            <p>
                {{t "customer-portal.ui.auth.forgot-password.sent-message" htmlSafe=true}}
            </p>
        </InfoBlock>
        <div class="flex flex-row">
            <Button @icon="check" @type="primary" @text={{t "customer-portal.ui.auth.forgot-password.continue"}} @onClick={{transition-to "portal-auth.login"}} />
        </div>
    {{else}}
        <InfoBlock @icon="info-circle" @iconSize="lg" @iconClass="mt-1" class="my-6">
            <p>
                {{t "customer-portal.ui.auth.forgot-password.message" htmlSafe=true appName=(t "app.name")}}
            </p>
        </InfoBlock>

        <form class="space-y-6" {{on "submit" (perform this.sendSecureLink)}}>
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-50">
                    {{t "customer-portal.ui.auth.forgot-password.email-label"}}
                </label>
                <div class="mt-2">
                    <Input
                        @value={{this.email}}
                        @type="email"
                        id="email"
                        name="email"
                        required
                        class="form-input form-input-lg w-full"
                        placeholder={{t "customer-portal.ui.auth.forgot-password.email-label"}}
                    />
                </div>
            </div>

            <div class="flex flex-row space-x-2">
                <Button
                    @icon="magic"
                    @type="primary"
                    @buttonType="submit"
                    @text={{t "customer-portal.ui.auth.forgot-password.submit"}}
                    @onClick={{perform this.sendSecureLink}}
                    @isLoading={{this.sendSecureLink.isRunning}}
                />
                <Button @buttonType="button" @text={{t "customer-portal.ui.auth.forgot-password.nevermind"}} @onClick={{fn (transition-to "portal-auth.login")}} @disabled={{this.isLoading}} />
            </div>
        </form>
    {{/if}}
</div>