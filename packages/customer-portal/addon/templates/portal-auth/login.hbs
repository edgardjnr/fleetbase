{{!-- Entregas: login do portal da loja com a faixa da marca. Página inteira (fixa sobre o layout portal-auth), no visual da landing do console (classes ent-* em console/app/styles/landing.css e entregas-telas.css). O fluxo é o original: tentativas falhas, "esqueci a senha" e os itens do registry customer-portal:auth:login. --}}
<div class="ent-tema ent-acesso">
    <aside class="ent-acesso-marca">
        <div class="ent-acesso-marca-topo">
            <LogoIcon @brand={{@brand}} @size="10" class="ent-marca-icone" />
            <span class="ent-acesso-marca-nome">Entregas</span>
            <span class="ent-acesso-marca-portal">{{t "customer-portal.ui.auth.login.portal-nome"}}</span>
        </div>
        <h1 class="ent-acesso-titulo">{{t "customer-portal.ui.auth.login.titulo-marca"}}</h1>
        <ol class="ent-acesso-lista">
            <li><img src="/images/entregas/loja-pin.png" alt="" width="26" height="30" /><span>{{t "customer-portal.ui.auth.login.item-pedir"}}</span></li>
            <li><img src="/images/entregas/capacete-vermelho.png" alt="" width="30" height="30" /><span>{{t "customer-portal.ui.auth.login.item-mapa"}}</span></li>
            <li><img src="/images/entregas/capacete-verde.png" alt="" width="30" height="30" /><span>{{t "customer-portal.ui.auth.login.item-extrato"}}</span></li>
        </ol>
    </aside>

    <main class="ent-acesso-corpo">
        <div class="ent-acesso-form">
            <h2 class="ent-acesso-form-titulo">{{t "customer-portal.ui.auth.login.titulo"}}</h2>
            <p class="ent-acesso-form-lead">{{t "customer-portal.ui.auth.login.lead"}}</p>

            {{#if (gte this.failedAttempts 3)}}
                <div class="ent-aviso" role="alert">
                    <p>{{t "customer-portal.ui.auth.login.failed-attempt-message" htmlSafe=true}}</p>
                    <button type="button" class="ent-aviso-botao" {{on "click" this.forgotPassword}}>{{t "customer-portal.ui.auth.login.failed-attempt-button"}}</button>
                </div>
            {{/if}}

            <form class="ent-form" {{on "submit" this.login}}>
                <input type="hidden" name="remember" value="true" />
                <label class="ent-campo" for="ent-portal-email">
                    <span class="ent-rotulo">{{t "customer-portal.ui.auth.login.email-label"}}</span>
                    <Input
                        id="ent-portal-email"
                        @value={{this.identity}}
                        name="email"
                        @type="email"
                        autocomplete="username"
                        required
                        class="ent-input"
                        disabled={{this.isLoading}}
                    />
                </label>
                <label class="ent-campo" for="ent-portal-senha">
                    <span class="ent-rotulo">{{t "customer-portal.ui.auth.login.password-label"}}</span>
                    <Input
                        id="ent-portal-senha"
                        @value={{this.password}}
                        name="password"
                        @type="password"
                        autocomplete="current-password"
                        required
                        class="ent-input"
                        disabled={{this.isLoading}}
                    />
                </label>

                <div class="ent-form-linha">
                    <label class="ent-lembrar" for="rememberMe">
                        <Input id="rememberMe" @type="checkbox" @checked={{this.rememberMe}} disabled={{this.isLoading}} class="ent-check" />
                        <span>{{t "customer-portal.ui.auth.login.remember-me"}}</span>
                    </label>
                    <button type="button" class="ent-link" disabled={{this.isLoading}} {{on "click" this.forgotPassword}}>{{t "customer-portal.ui.auth.login.forgot-password"}}</button>
                </div>

                <button type="submit" class="ent-botao ent-botao-tinta ent-botao-cheio ent-botao-ui" disabled={{this.isLoading}} aria-busy={{if this.isLoading "true" "false"}}>
                    {{#if this.isLoading}}
                        <span class="ent-giro" aria-hidden="true"></span>
                        {{t "customer-portal.ui.auth.login.entrando"}}
                    {{else}}
                        {{t "customer-portal.ui.auth.login.sign-in"}}
                    {{/if}}
                </button>

                <div class="ent-registro">
                    <RegistryYield @type="menu" @registry="customer-portal:auth:login" as |menuItem|>
                        <Button
                            @text={{menuItem.title}}
                            @type={{menuItem.type}}
                            @wrapperClass={{menuItem.wrapperClass}}
                            @disabled={{this.isLoading}}
                            @onClick={{menuItem.onClick}}
                            @permission={{menuItem.permission}}
                        />
                    </RegistryYield>
                </div>
            </form>

            <p class="ent-acesso-rodape">
                {{t "customer-portal.ui.auth.login.central-pergunta"}}
                <button type="button" class="ent-link" {{on "click" this.transitionToConsole}}>{{t "customer-portal.ui.auth.login.central-link"}}</button>
            </p>
        </div>
    </main>
</div>
