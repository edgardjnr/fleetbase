<Portal::ContentWrapper class="portal-page-card portal-table-page-card">
    <div class="portal-section-header">
        <div>
            <h1>{{t "customer-portal.ui.entregas.statement-title"}}</h1>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <Button @icon="rotate" @text={{t "customer-portal.ui.entregas.refresh"}} @onClick={{this.atualizar}} @isLoading={{this.carregar.isRunning}} />
            <Button @type="primary" @icon="download" @text={{t "customer-portal.ui.entregas.export-csv"}} @onClick={{this.baixarCsv}} @disabled={{not this.temEntregas}} />
        </div>
    </div>

    {{! Entregas: a consulta sai no `change` dos campos (com uma espera curta, ver o controller); o período vem da loja da sessão, que não é enviada }}
    <div class="flex flex-wrap items-end gap-3 mt-4">
        <InputGroup @name={{t "customer-portal.ui.entregas.period-start"}} @wrapperClass="mb-0i" as |inputId|>
            <input id={{inputId}} type="date" class="form-input" value={{this.inicio}} {{on "change" this.setInicio}} />
        </InputGroup>
        <InputGroup @name={{t "customer-portal.ui.entregas.period-end"}} @wrapperClass="mb-0i" as |inputId|>
            <input id={{inputId}} type="date" class="form-input" value={{this.fim}} {{on "change" this.setFim}} />
        </InputGroup>
    </div>

    {{! Entregas: três colunas só a partir de md; antes disso o valor (fonte grande, sem quebra) seria cortado nos cartões estreitos }}
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3 mt-4">
        <div class="portal-dashboard-widget portal-kpi-tile portal-kpi-accent-blue">
            <div class="portal-kpi-content">
                <div class="min-w-0">
                    <div class="portal-kpi-label">{{t "customer-portal.ui.entregas.deliveries"}}</div>
                    <div class="portal-kpi-value">{{this.totalEntregas}}</div>
                </div>
                <div class="portal-kpi-icon"><FaIcon @icon="circle-check" /></div>
            </div>
        </div>
        <div class="portal-dashboard-widget portal-kpi-tile portal-kpi-accent-indigo">
            <div class="portal-kpi-content">
                <div class="min-w-0">
                    <div class="portal-kpi-label">{{t "customer-portal.ui.entregas.total-km"}}</div>
                    <div class="portal-kpi-value">{{this.totalKm}}</div>
                </div>
                <div class="portal-kpi-icon"><FaIcon @icon="route" /></div>
            </div>
        </div>
        <div class="portal-dashboard-widget portal-kpi-tile portal-kpi-accent-green">
            <div class="portal-kpi-content">
                <div class="min-w-0">
                    <div class="portal-kpi-label">{{t "customer-portal.ui.entregas.amount-due"}}</div>
                    <div class="portal-kpi-value" title={{this.totalValor}}>{{this.totalValor}}</div>
                </div>
                <div class="portal-kpi-icon"><FaIcon @icon="file-invoice-dollar" /></div>
            </div>
        </div>
    </div>

    {{#if this.pendentes}}
        <div
            class="flex items-start gap-2 mt-4 rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-900/30 dark:text-amber-200"
            role="status"
        >
            <FaIcon @icon="triangle-exclamation" class="mt-0.5" />
            <span>{{t "customer-portal.ui.entregas.pending-km" count=this.pendentes}}</span>
        </div>
    {{/if}}

    {{! Entregas: com dados na tela, uma nova consulta só os escurece (continuam visíveis até a resposta chegar) }}
    <div class="mt-5 transition-opacity {{if this.atualizando 'opacity-60'}}">
        {{#if this.dados}}
            <div class="next-table-wrapper no-scroll h-auto table-fluid portal-table-panel">
                <table class="table portal-table">
                    <thead>
                        <tr>
                            <th class="text-left">{{t "customer-portal.ui.entregas.completed-at"}}</th>
                            <th class="text-left">{{t "customer-portal.ui.entregas.order"}}</th>
                            <th class="text-left">{{t "customer-portal.ui.entregas.destination"}}</th>
                            <th class="text-right">{{t "customer-portal.ui.entregas.km"}}</th>
                            <th class="text-left">{{t "customer-portal.ui.entregas.band"}}</th>
                            <th class="text-right">{{t "customer-portal.ui.entregas.amount"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each this.entregas as |entrega|}}
                            <tr>
                                <td class="whitespace-nowrap">{{this.dataHora entrega.concluido_em}}</td>
                                <td class="font-semibold whitespace-nowrap">{{or entrega.id_interno entrega.pedido}}</td>
                                <td><div class="max-w-sm">{{n-a entrega.destino "—"}}</div></td>
                                <td class="text-right whitespace-nowrap tabular-nums">{{this.distancia entrega.km}}</td>
                                <td class="whitespace-nowrap">{{this.textoFaixa entrega.faixa}}</td>
                                <td class="text-right whitespace-nowrap font-semibold tabular-nums">{{this.dinheiro entrega.valor}}</td>
                            </tr>
                        {{else}}
                            <tr>
                                <td colspan="6">
                                    <div class="portal-empty-state portal-table-empty-state">
                                        <div class="portal-empty-state-icon"><FaIcon @icon="file-invoice-dollar" /></div>
                                        <div class="portal-empty-state-title">{{t "customer-portal.ui.entregas.no-deliveries"}}</div>
                                    </div>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        {{else if this.carregar.isRunning}}
            <div class="portal-empty-state portal-table-empty-state">
                <Spinner />
            </div>
        {{else}}
            {{! Entregas: a primeira consulta falhou (o aviso do erro já apareceu); sobra o atalho para tentar de novo }}
            <div class="portal-empty-state portal-table-empty-state">
                <div class="portal-empty-state-icon"><FaIcon @icon="file-invoice-dollar" /></div>
                <Button @icon="rotate" @text={{t "customer-portal.ui.entregas.refresh"}} @onClick={{this.atualizar}} />
            </div>
        {{/if}}
    </div>
</Portal::ContentWrapper>
