<Portal::ContentWrapper class="portal-page-card portal-table-page-card">
    <div class="portal-section-header">
        <div>
            <h1>{{t "customer-portal.ui.entregas.financeiro.title"}}</h1>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <Button @icon="rotate" @text={{t "customer-portal.ui.entregas.refresh"}} @onClick={{this.atualizar}} @isLoading={{this.carregar.isRunning}} />
        </div>
    </div>

    {{#if this.dados}}
        {{! Entregas: o ciclo em andamento são os lançamentos da loja ainda sem fatura; entram na próxima fatura emitida }}
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 mt-4 transition-opacity {{if this.atualizando 'opacity-60'}}">
            <div class="portal-dashboard-widget portal-kpi-tile portal-kpi-accent-blue">
                <div class="portal-kpi-content">
                    <div class="min-w-0">
                        <div class="portal-kpi-label">{{t "customer-portal.ui.entregas.financeiro.current-cycle"}}</div>
                        <div class="portal-kpi-value" title={{this.valorDoCiclo}}>{{this.valorDoCiclo}}</div>
                        {{#if this.ciclo}}
                            <div class="mt-1 text-sm text-gray-700 dark:text-gray-200">{{this.resumoDoCiclo}}</div>
                        {{/if}}
                        <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t "customer-portal.ui.entregas.financeiro.current-cycle-help"}}</div>
                    </div>
                    <div class="portal-kpi-icon"><FaIcon @icon="hourglass-half" /></div>
                </div>
            </div>
        </div>

        <div class="mt-5 transition-opacity {{if this.atualizando 'opacity-60'}}">
            <div class="next-table-wrapper no-scroll h-auto table-fluid portal-table-panel">
                <table class="table portal-table">
                    <thead>
                        <tr>
                            <th class="text-left">{{t "customer-portal.ui.entregas.financeiro.number"}}</th>
                            <th class="text-left">{{t "customer-portal.ui.entregas.financeiro.period"}}</th>
                            <th class="text-left">{{t "customer-portal.ui.entregas.financeiro.due-date"}}</th>
                            <th class="text-right">{{t "customer-portal.ui.entregas.financeiro.total"}}</th>
                            <th class="text-right">{{t "customer-portal.ui.entregas.financeiro.received"}}</th>
                            <th class="text-right">{{t "customer-portal.ui.entregas.financeiro.open-amount"}}</th>
                            <th class="text-left">{{t "customer-portal.ui.entregas.financeiro.status"}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each this.faturas as |linha|}}
                            <tr class="cursor-pointer {{if (eq linha.situacao 'cancelada') 'entregas-fatura-linha-cancelada'}}" {{on "click" (fn this.abrir linha.fatura)}}>
                                <td class="font-semibold whitespace-nowrap">
                                    <LinkTo @route="portal.fatura" @model={{linha.fatura.id}}>{{this.numero linha.fatura}}</LinkTo>
                                </td>
                                <td class="whitespace-nowrap">{{this.periodo linha.fatura}}</td>
                                <td class="whitespace-nowrap {{if (eq linha.situacao 'vencida') 'entregas-fatura-texto-vencida'}}">{{this.dataCurta linha.fatura.vencimento}}</td>
                                <td class="text-right whitespace-nowrap font-semibold tabular-nums">{{this.dinheiro linha.fatura.total}}</td>
                                <td class="text-right whitespace-nowrap tabular-nums">{{this.dinheiro linha.fatura.recebido}}</td>
                                <td class="text-right whitespace-nowrap tabular-nums">{{this.dinheiro linha.fatura.em_aberto}}</td>
                                <td class="whitespace-nowrap"><span class={{linha.classe}}>{{linha.rotulo}}</span></td>
                            </tr>
                        {{else}}
                            <tr>
                                <td colspan="7">
                                    <div class="portal-empty-state portal-table-empty-state">
                                        <div class="portal-empty-state-icon"><FaIcon @icon="file-invoice" /></div>
                                        <div class="portal-empty-state-title">{{t "customer-portal.ui.entregas.financeiro.no-invoices"}}</div>
                                    </div>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    {{else if this.carregar.isRunning}}
        <div class="portal-empty-state portal-table-empty-state mt-5">
            <Spinner />
        </div>
    {{else}}
        {{! Entregas: a consulta falhou (o aviso do erro já apareceu); sobra o atalho para tentar de novo }}
        <div class="portal-empty-state portal-table-empty-state mt-5">
            <div class="portal-empty-state-icon"><FaIcon @icon="file-invoice" /></div>
            <Button @icon="rotate" @text={{t "customer-portal.ui.entregas.refresh"}} @onClick={{this.atualizar}} />
        </div>
    {{/if}}
</Portal::ContentWrapper>
