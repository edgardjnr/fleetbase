<div class="portal-dashboard-page">
    <div class="portal-dashboard-hero">
        <div>
            <div class="portal-dashboard-eyebrow">{{this.accountTypeLabel}}</div>
            <h1>{{t "customer-portal.ui.home.welcome" name=this.customerName}}</h1>
            <p>{{t "customer-portal.ui.home.description"}}</p>
        </div>
        <div class="portal-dashboard-quick-actions">
            <LinkTo @route="portal.orders.new" class="portal-quick-link primary">
                <FaIcon @icon="plus" />
                <span>{{t "customer-portal.ui.order.new-order"}}</span>
            </LinkTo>
            <LinkTo @route="portal.orders" class="portal-quick-link">
                <FaIcon @icon="boxes-packing" />
                <span>{{t "customer-portal.ui.nav.orders"}}</span>
            </LinkTo>
            <LinkTo @route="portal.extrato" class="portal-quick-link">
                <FaIcon @icon="file-invoice-dollar" />
                <span>{{t "customer-portal.ui.entregas.statement"}}</span>
            </LinkTo>
        </div>
    </div>

    {{!-- Entregas: painel só leitura (o servidor nega ao usuário de loja criar, editar e adicionar widgets; com zero widgets o painel de widgets também não abre); o nome do painel é chave de tradução --}}
    <Dashboard
        @defaultDashboardId="customer-portal-overview-v2"
        @defaultDashboardName="customer-portal.ui.entregas.dashboard-name"
        @readOnly={{true}}
        @showPanelWhenZeroWidgets={{false}}
        @stickyHeader={{true}}
        @leftHeaderWrapperClass="portal-dashboard-title"
        @rightHeaderWrapperClass="portal-dashboard-actions"
        @createWrapperClass="portal-dashboard-create-wrapper"
        class="portal-dashboard-grid"
    />
</div>
