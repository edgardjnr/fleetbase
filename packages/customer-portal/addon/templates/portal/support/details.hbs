<Portal::ContentWrapper class="portal-page-card portal-support-ticket-page">
    {{#if this.issue}}
        <div class="portal-ticket-header">
            <div class="portal-ticket-header-main">
                <LinkTo @route="portal.support" class="portal-ticket-back-link">
                    <FaIcon @icon="arrow-left" />
                    <span>{{t "customer-portal.ui.support.back"}}</span>
                </LinkTo>
                <div class="portal-section-eyebrow">{{t "customer-portal.ui.support.eyebrow"}}</div>
                <h1>{{this.title}}</h1>
                <div class="portal-ticket-badge-row">
                    <Badge @status={{this.issue.status}} @text={{this.statusLabel}} />
                    <Badge @status={{this.issue.priority}} @text={{this.priorityLabel}} />
                    <span class="portal-ticket-id">{{this.ticketNumber}}</span>
                </div>
                {{#if this.hasIssueTags}}
                    <div class="portal-ticket-tag-row">
                        {{#each this.issueTags as |tag|}}
                            <Badge @status="info" @text={{tag}} @hideStatusDot={{true}} />
                        {{/each}}
                    </div>
                {{/if}}
            </div>
            <div class="portal-ticket-header-dates">
                <div>
                    <span>{{t "customer-portal.ui.common.created"}}</span>
                    <strong>{{n-a (format-date-fns this.issue.created_at "MMM d, yyyy HH:mm")}}</strong>
                </div>
                <div>
                    <span>{{t "customer-portal.ui.support.last-updated"}}</span>
                    <strong>{{n-a (format-date-fns this.issue.updated_at "MMM d, yyyy HH:mm")}}</strong>
                </div>
            </div>
        </div>

        <div class="portal-ticket-layout">
            <main class="portal-ticket-conversation">
                <article class="portal-ticket-message portal-ticket-message-original">
                    <div class="portal-ticket-avatar" aria-hidden="true">{{this.reporterInitials}}</div>
                    <div class="portal-ticket-message-content">
                        <div class="portal-ticket-message-meta">
                            <div>
                                <div class="portal-ticket-message-author">{{this.reporterName}}</div>
                                {{#if this.reporterEmail}}
                                    <div class="portal-ticket-message-subtitle">{{this.reporterEmail}}</div>
                                {{/if}}
                            </div>
                            <time>{{n-a (format-date-fns this.issue.created_at "MMM d, yyyy 'at' h:mm a")}}</time>
                        </div>
                        <div class="portal-ticket-report">{{n-a this.issue.report}}</div>

                        {{#if this.hasIssueAttachments}}
                            <div class="portal-ticket-attachments">
                                <div class="portal-ticket-attachments-title">{{t "customer-portal.ui.support.attachments-count" count=this.issueAttachments.length}}</div>
                                <div class="portal-ticket-attachment-grid">
                                    {{#each this.issueAttachments as |file|}}
                                        <File @file={{file}} @onDownload={{this.downloadFile}} />
                                    {{/each}}
                                </div>
                            </div>
                        {{/if}}
                    </div>
                </article>

                <section class="portal-ticket-thread">
                    <div class="portal-ticket-thread-header">
                        <div>
                            <div class="portal-ticket-section-title">{{t "customer-portal.ui.support.correspondence"}}</div>
                            <p>{{t "customer-portal.ui.support.correspondence-text"}}</p>
                        </div>
                    </div>

                    <CommentThread
                        @subject={{this.issue}}
                        @subjectType="fleet-ops:issue"
                        @comments={{this.comments}}
                        @onReloadComments={{this.reloadComments}}
                        @onPublishComment={{this.publishComment}}
                        @onPublishReply={{this.publishReply}}
                        @onUpdateComment={{this.updateComment}}
                        @onDeleteComment={{this.deleteComment}}
                        class="portal-support-comment-thread"
                    />

                    {{#unless this.hasComments}}
                        <div class="portal-ticket-no-replies">
                            <FaIcon @icon="comments" />
                            <span>{{t "customer-portal.ui.support.no-replies"}}</span>
                        </div>
                    {{/unless}}
                </section>
            </main>

            <aside class="portal-ticket-meta-rail">
                <div class="portal-ticket-meta-section">
                    <div class="portal-ticket-section-title">{{t "customer-portal.ui.support.ticket-details"}}</div>
                    <dl>
                        <div>
                            <dt>{{t "customer-portal.ui.support.ticket"}}</dt>
                            <dd>{{this.ticketNumber}}</dd>
                        </div>
                        <div>
                            <dt>{{t "customer-portal.ui.common.status"}}</dt>
                            <dd><Badge @status={{this.issue.status}} @text={{this.statusLabel}} /></dd>
                        </div>
                        <div>
                            <dt>{{t "customer-portal.ui.support.priority"}}</dt>
                            <dd><Badge @status={{this.issue.priority}} @text={{this.priorityLabel}} /></dd>
                        </div>
                        {{#if this.relatedOrderLabel}}
                            <div>
                                <dt>{{t "customer-portal.ui.support.related-order"}}</dt>
                                <dd>
                                    {{#if this.hasRelatedOrderDetails}}
                                        <LinkTo @route="portal.orders.details" @model={{this.relatedOrderId}} class="portal-ticket-related-order-link">
                                            <FaIcon @icon="box" />
                                            <span>{{this.relatedOrderLabel}}</span>
                                        </LinkTo>
                                    {{else}}
                                        {{this.relatedOrderLabel}}
                                    {{/if}}
                                </dd>
                            </div>
                        {{/if}}
                        <div>
                            <dt>{{t "customer-portal.ui.support.tags"}}</dt>
                            <dd>
                                {{#if this.hasIssueTags}}
                                    <div class="portal-ticket-meta-tags">
                                        {{#each this.issueTags as |tag|}}
                                            <Badge @status="info" @text={{tag}} @hideStatusDot={{true}} />
                                        {{/each}}
                                    </div>
                                {{else}}
                                    {{t "customer-portal.ui.common.none"}}
                                {{/if}}
                            </dd>
                        </div>
                    </dl>
                </div>

                <div class="portal-ticket-meta-section">
                    <div class="portal-ticket-section-title">{{t "customer-portal.ui.support.timeline"}}</div>
                    <dl>
                        <div>
                            <dt>{{t "customer-portal.ui.common.created"}}</dt>
                            <dd>{{n-a (format-date-fns this.issue.created_at "MMM d, yyyy HH:mm")}}</dd>
                        </div>
                        <div>
                            <dt>{{t "customer-portal.ui.support.last-updated"}}</dt>
                            <dd>{{n-a (format-date-fns this.issue.updated_at "MMM d, yyyy HH:mm")}}</dd>
                        </div>
                    </dl>
                </div>
            </aside>
        </div>
    {{else}}
        <div class="portal-empty-state">
            <div class="portal-empty-state-icon"><FaIcon @icon="headset" /></div>
            <div class="portal-empty-state-title">{{t "customer-portal.ui.support.not-found-title"}}</div>
            <p>{{t "customer-portal.ui.support.not-found-text"}}</p>
        </div>
    {{/if}}
</Portal::ContentWrapper>
