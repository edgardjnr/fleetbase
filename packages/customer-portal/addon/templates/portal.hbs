<Portal::Container>
    <div class="portal-topbar">
        <div class="portal-topbar-account">
            {{!-- Entregas: ☰ do menu. Na tela Pedidos abre a gaveta Portal::Gaveta (a coluna do menu fica com a lista de
                 pedidos); nas outras, esconde ou mostra a coluna do menu --}}
            <button
                type="button"
                class="portal-menu-toggle"
                aria-label={{t "customer-portal.ui.entregas.menu.abrir"}}
                aria-expanded={{if this.menuVisivel "true" "false"}}
                aria-controls={{if this.naTelaPedidos "portal-gaveta" "portal-sidebar"}}
                {{on "click" this.alternarMenu}}
            >
                <FaIcon @icon="bars" />
            </button>
            <div class="portal-account-mark">
                <FaIcon @icon="building-user" />
            </div>
            <div class="min-w-0">
                <div class="portal-account-eyebrow">{{this.accountTypeLabel}}</div>
                <div class="portal-account-name">{{this.accountName}}</div>
            </div>
        </div>
        <div class="portal-topbar-actions">
            <BasicDropdown class="portal-user-menu" @renderInPlace={{true}} as |dd|>
                <dd.Trigger class="portal-user-trigger">
                    <Image
                        src={{this.currentUser.avatarUrl}}
                        @fallbackSrc="https://s3.ap-southeast-1.amazonaws.com/flb-assets/static/no-avatar.png"
                        alt={{this.currentUser.name}}
                        class="portal-user-avatar"
                    />
                    <div class="hidden sm:flex flex-col min-w-0 text-left">
                        <span class="portal-user-name">{{this.currentUser.name}}</span>
                        <span class="portal-user-email">{{this.accountEmail}}</span>
                    </div>
                    <FaIcon @icon="caret-down" class="text-gray-400 text-xs" />
                </dd.Trigger>
                <dd.Content>
                    <div class="next-dd-menu">
                        <div class="px-1">
                            <Layout::Sidebar::Item class="next-dd-item" @route="customer-portal.portal.settings.account" @icon="gear">{{t "customer-portal.ui.nav.account-settings"}}</Layout::Sidebar::Item>
                        </div>
                        <Layout::Header::DarkModeToggle />
                        <div class="next-dd-menu-seperator"></div>
                        <div class="px-1">
                            <Layout::Sidebar::Item class="next-dd-item" @onClick={{this.invalidateSession}} @icon="person-running">{{t "customer-portal.ui.nav.logout"}}</Layout::Sidebar::Item>
                        </div>
                    </div>
                </dd.Content>
            </BasicDropdown>
        </div>
    </div>
    <Portal::Main class="{{if this.naTelaPedidos 'is-pedidos'}} {{if this.gavetaAberta 'gaveta-aberta'}} {{if this.menuEscondido 'menu-escondido'}}">
        <Portal::Sidebar>
            <div class="portal-nav-group">
                <div class="portal-nav-label">{{t "customer-portal.ui.nav.workspace"}}</div>
                <Layout::Sidebar::Item @route="customer-portal.portal.home" @icon="home">{{t "customer-portal.ui.nav.dashboard"}}</Layout::Sidebar::Item>
                <Layout::Sidebar::Item @route="customer-portal.portal.orders" @icon="boxes-packing">{{t "customer-portal.ui.nav.orders"}}</Layout::Sidebar::Item>
                <Layout::Sidebar::Item @route="customer-portal.portal.extrato" @icon="file-invoice-dollar">{{t "customer-portal.ui.entregas.statement"}}</Layout::Sidebar::Item>
                {{!-- Entregas: faturas da loja; o detalhe (financeiro/:id) é outra rota e não acende este item --}}
                <Layout::Sidebar::Item @route="customer-portal.portal.financeiro" @icon="file-invoice">{{t "customer-portal.ui.entregas.financeiro.menu"}}</Layout::Sidebar::Item>
                {{!-- Entregas: rota-pai para o item acender nas duas abas (Sidebar::Item compara com startsWith); settings.index redireciona para a aba da conta --}}
                <Layout::Sidebar::Item @route="customer-portal.portal.settings" @icon="gear">{{t "customer-portal.ui.nav.account-settings"}}</Layout::Sidebar::Item>
            </div>
            <RegistryYield @type="menu" @registry="customer-portal:sidebar" as |menuItem|>
                <Layout::Sidebar::Item
                    @onClick={{fn this.universe.transitionMenuItem "customer-portal.portal.virtual" menuItem}}
                    @item={{menuItem}}
                    @icon={{menuItem.icon}}
                    @permission={{menuItem.permission}}
                >{{menuItem.title}}</Layout::Sidebar::Item>
            </RegistryYield>
        </Portal::Sidebar>
        {{!-- Entregas: na tela Pedidos o menu é esta gaveta (sketch 003, B), opaca e por cima do mapa --}}
        {{#if this.gavetaAberta}}
            <Portal::Gaveta @nomeDaConta={{this.accountName}} @email={{this.accountEmail}} @onFechar={{this.fecharGaveta}} @onSair={{this.invalidateSession}} />
        {{/if}}
        <Portal::Section>{{outlet}}</Portal::Section>
    </Portal::Main>
    <Portal::Footer />
</Portal::Container>
