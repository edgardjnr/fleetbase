{{!-- Entregas: a moldura do portal no desenho do sketch 009 S: o topo com as abas (Portal::Topo) em todas as telas e o
     conteúdo numa folha de cantos arredondados. Sem menu lateral nem gaveta (☰). No celular, o Novo pedido vira a barra
     fixa embaixo (some na própria tela do novo pedido e na tela Pedidos, onde a folha de baixo já tem o botão) --}}
<Portal::Container>
    <Portal::Topo @nomeDaConta={{this.accountName}} @email={{this.accountEmail}} @onSair={{this.invalidateSession}} />
    <Portal::Main>
        <Portal::Section>{{outlet}}</Portal::Section>
    </Portal::Main>
    {{#if this.mostrarBarraNovo}}
        <div class="ps-barra-novo">
            <LinkTo @route="portal.orders.new" class="ps-btn ps-btn-marca"><FaIcon @icon="plus" /><span>{{t "customer-portal.ui.order.new-order"}}</span></LinkTo>
        </div>
    {{/if}}
    <Portal::Footer />
</Portal::Container>
