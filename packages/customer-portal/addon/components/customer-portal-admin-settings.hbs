<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl mx-auto space-y-4">
            <ContentPanel @title={{t "customer-portal.ui.admin.title"}} @open={{true}} @wrapperClass="bordered-classic">
                {{#if this.getConfig.isRunning}}
                    <div class="mb-4">
                        <Spinner />
                    </div>
                {{else}}
                    <InputGroup @name={{t "customer-portal.ui.admin.access"}} @helpText={{t "customer-portal.ui.admin.access-help"}} @wrapperClass="mb-4">
                        <CustomerPortalUrlInput
                            @value={{this.accessUrlSlug}}
                            @placeholder={{t "customer-portal.ui.admin.url-placeholder"}}
                            @onChange={{perform this.setAccessUrlSlug}}
                            class="w-full"
                            disabled={{this.saveConfig.isRunning}}
                        />
                        {{#unless this.accessUrlSlugValidation.valid}}
                            <InfoBlock @type="danger" @size="sm" @icon="triangle-exclamation" @text={{this.accessUrlSlugValidation.message}} class="mt-2" />
                        {{/unless}}
                    </InputGroup>
                    <InputGroup @name={{t "customer-portal.ui.admin.order-types"}} @helpText={{t "customer-portal.ui.admin.order-types-help"}} @wrapperClass="mb-4">
                        <div class="space-y-1">
                            {{#each this.orderConfigs as |orderConfig|}}
                                <Checkbox @value={{includes orderConfig.uuid this.enabledOrderConfigIds}} @onChange={{fn this.toggleOrderConfig orderConfig}}>
                                    <span class="font-semibold">{{orderConfig.name}}</span>
                                    {{#if orderConfig.key}}
                                        <span class="text-xs text-gray-500 dark:text-gray-400 ml-1">{{orderConfig.key}}</span>
                                    {{/if}}
                                </Checkbox>
                            {{else}}
                                <InfoBlock @type="warning" @size="sm" @text={{t "customer-portal.ui.admin.no-order-types"}} />
                            {{/each}}
                        </div>
                    </InputGroup>
                    <InputGroup @name={{t "customer-portal.ui.admin.service-rates"}} @helpText={{t "customer-portal.ui.admin.service-rates-help"}} @wrapperClass="mb-4">
                        <div class="space-y-1">
                            {{#each this.serviceRates as |serviceRate|}}
                                <Checkbox @value={{includes serviceRate.uuid this.enabledServiceRateIds}} @onChange={{fn this.toggleServiceRate serviceRate}}>
                                    <span class="font-semibold">{{or serviceRate.service_name serviceRate.name serviceRate.public_id}}</span>
                                    {{#if serviceRate.currency}}
                                        <span class="text-xs text-gray-500 dark:text-gray-400 ml-1">{{serviceRate.currency}}</span>
                                    {{/if}}
                                </Checkbox>
                            {{else}}
                                <InfoBlock @type="warning" @size="sm" @text={{t "customer-portal.ui.admin.no-service-rates"}} />
                            {{/each}}
                        </div>
                    </InputGroup>
                    <InputGroup @name={{t "customer-portal.ui.admin.enable-stripe"}} @wrapperClass="mb-4">
                        <Toggle
                            @isToggled={{this.paymentsEnabled}}
                            @onToggle={{this.togglePayments}}
                            @label={{t "customer-portal.ui.admin.require-stripe"}}
                        />
                        <div class="space-y-2 mt-4">
                            {{#unless this.paymentsOnboardCompleted}}
                                <InfoBlock @type="warning" @icon="triangle-exclamation">
                                    <span>{{t "customer-portal.ui.admin.onboarding-required"}}</span>
                                    <Button @text={{t "customer-portal.ui.admin.complete-onboarding"}} @onClick={{transition-to "console.fleet-ops.settings.payments.onboard"}} @wrapperClass="mt-2" />
                                </InfoBlock>
                            {{/unless}}
                            <InfoBlock
                                @type={{if this.isStripeEnabled "success" "warning"}}
                                @icon={{if this.isStripeEnabled "check" "triangle-exclamation"}}
                                @text={{if this.isStripeEnabled (t "customer-portal.ui.admin.stripe-configured") (t "customer-portal.ui.admin.stripe-not-configured")}}
                            />
                        </div>
                    </InputGroup>
                {{/if}}
                <div class="mt-2">
                    <Button
                        @type="primary"
                        @icon="save"
                        @text={{t "customer-portal.ui.admin.save-settings"}}
                        @onClick={{perform this.saveConfig}}
                        @isLoading={{or this.saveConfig.isRunning this.setAccessUrlSlug.isRunning}}
                        @disabled={{this.saveDisabled}}
                    />
                </div>
            </ContentPanel>
            <RegistryYield @registry="customer-portal:admin-settings" as |Component|>
                <Component @context={{this}} />
            </RegistryYield>
        </div>
    </div>
    <Spacer @height="300px" />
</Layout::Section::Body>
