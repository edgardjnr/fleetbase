<div class="portal-gaveta-fundo" role="presentation" {{on "click" @onFechar}}></div>
<aside id="portal-gaveta" class="portal-gaveta" aria-label={{t "customer-portal.ui.entregas.menu.titulo"}}>
    <div class="portal-gaveta-topo">
        <div class="portal-gaveta-linha">
            <div class="portal-gaveta-logo" aria-hidden="true">{{this.iniciais}}</div>
            <button type="button" class="portal-gaveta-fechar" aria-label={{t "customer-portal.ui.entregas.menu.fechar"}} {{on "click" @onFechar}}>
                <FaIcon @icon="xmark" />
            </button>
        </div>
        <div class="portal-gaveta-nome">{{this.nome}}</div>
        {{#if this.endereco}}
            <div class="portal-gaveta-endereco"><FaIcon @icon="location-dot" /> {{this.endereco}}</div>
        {{/if}}
    </div>

    <div class="portal-gaveta-hoje" aria-label={{t "customer-portal.ui.entregas.menu.hoje"}}>
        <div class="portal-gaveta-numero">
            <span class="portal-gaveta-numero-icone is-azul"><FaIcon @icon="boxes-packing" /></span>
            <b>{{this.hoje.emAndamento}}</b>
            <span>{{t "customer-portal.ui.entregas.menu.hoje-em-andamento"}}</span>
        </div>
        <div class="portal-gaveta-numero">
            <span class="portal-gaveta-numero-icone is-verde"><FaIcon @icon="circle-check" /></span>
            <b>{{this.hoje.entreguesHoje}}</b>
            <span>{{t "customer-portal.ui.entregas.menu.hoje-entregues"}}</span>
        </div>
        <div class="portal-gaveta-numero">
            <span class="portal-gaveta-numero-icone is-laranja"><FaIcon @icon="helmet-safety" /></span>
            <b>{{this.hoje.motoboysOnline}}</b>
            <span>{{t "customer-portal.ui.entregas.menu.hoje-online"}}</span>
        </div>
    </div>

    <div class="portal-gaveta-acao">
        <LinkTo @route="portal.orders.new" class="portal-gaveta-novo">
            <FaIcon @icon="plus" />
            <span>{{t "customer-portal.ui.entregas.menu.novo-pedido"}}</span>
        </LinkTo>
    </div>

    <nav class="portal-gaveta-menu">
        {{#each this.itens as |item|}}
            <LinkTo @route={{item.rota}} class="portal-gaveta-item is-{{item.chave}}">
                <span class="portal-gaveta-item-icone"><FaIcon @icon={{item.icone}} /></span>
                <span class="portal-gaveta-item-texto">{{t item.texto}}</span>
                {{#if item.contagem}}
                    <span class="portal-gaveta-contagem">{{this.hoje.emAndamento}}</span>
                {{else}}
                    <FaIcon @icon="chevron-right" class="portal-gaveta-seta" />
                {{/if}}
            </LinkTo>
        {{/each}}
    </nav>

    <div class="portal-gaveta-conta">
        <Image
            src={{this.currentUser.avatarUrl}}
            @fallbackSrc="/images/entregas/padrao/static/no-avatar.png"
            alt={{@nomeDaConta}}
            class="portal-gaveta-avatar"
        />
        <div class="portal-gaveta-conta-texto">
            <div class="portal-gaveta-conta-nome">{{@nomeDaConta}}</div>
            <div class="portal-gaveta-conta-email">{{@email}}</div>
        </div>
        <label class="portal-gaveta-tema" title={{t "customer-portal.ui.entregas.menu.tema-escuro"}}>
            <input type="checkbox" checked={{this.escuro}} aria-label={{t "customer-portal.ui.entregas.menu.tema-escuro"}} {{on "change" this.alternarTema}} />
            <span class="portal-gaveta-tema-trilho"></span>
            <FaIcon @icon="moon" class="portal-gaveta-tema-lua" />
        </label>
        <button type="button" class="portal-gaveta-sair" title={{t "customer-portal.ui.entregas.menu.sair"}} aria-label={{t "customer-portal.ui.entregas.menu.sair"}} {{on "click" @onSair}}>
            <FaIcon @icon="arrow-right-from-bracket" />
        </button>
    </div>
</aside>
