<Layout::Resource::Panel
    @resource={{this.order}}
    @headerComponent={{component "portal/order/panel-header" resource=this.order}}
    @actionButtons={{this.actionButtons}}
    @onPressCancel={{this.close}}
    @headerClass="no-bottom-border"
    @bodyClass="no-scroll portal-order-details-panel-body"
    @width="530px"
    class="portal-order-panel-overlay"
>
    <div class="details-wrapper scrollable">
        {{#if this.cancelLocked}}
            {{!-- Entregas: depois do aceite o cancelar fica desabilitado no menu de ações; o aviso explica o motivo --}}
            <div class="flex items-start px-4 py-2 space-x-2 text-sm text-gray-600 dark:text-gray-300 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
                <FaIcon @icon="lock" class="mt-0.5" />
                <span>{{t "customer-portal.ui.entregas.cancel-locked"}}</span>
            </div>
        {{/if}}
        <Portal::Order::Details::Activity @resource={{this.order}} />
        {{!-- Entregas: motoboy do pedido (nome, foto e posição), logo depois da atividade. O ciclo do detalhe consulta e
             passa os dados; @aceito é o pedido já aceito, pelo detalhe relido (o painel não diz "aguardando" com ele).
             Com o pedido encerrado, o painel some --}}
        {{#if this.isOpen}}
            <Portal::Order::Details::Motoboy @motoboy={{this.motoboy}} @consultado={{this.motoboyConsultado}} @aceito={{this.aceito}} />
        {{/if}}
        <Portal::Order::Details::Details @resource={{this.order}} />
        {{!-- Entregas: sem tarifa, carga, documentos e campos personalizados (fora do escopo; arquivos e cotações são negados à loja) --}}
        <Portal::Order::Details::Tracking @resource={{this.order}} />
        <Portal::Order::Details::Route @resource={{this.order}} />
        <Portal::Order::Details::Proof @resource={{this.order}} />
        <Portal::Order::Details::Notes @resource={{this.order}} />
        <Spacer @height="200px" />
    </div>
</Layout::Resource::Panel>
