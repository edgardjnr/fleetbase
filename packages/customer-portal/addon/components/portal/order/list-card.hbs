{{!-- Entregas: card do sketch 002 ("A compacto"); o LinkTo ganha a classe active com o pedido aberto no detalhe --}}
<LinkTo @route="portal.orders.details" @model={{this.identifier}} class="portal-order-card" ...attributes>
    <div class="portal-order-card-main">
        <div class="portal-order-card-topline">
            {{#if this.numero}}
                <span class="portal-order-card-numero">#{{this.numero}}</span>
            {{else}}
                <span class="portal-order-card-numero sem-numero">{{this.trackingNumber}}</span>
            {{/if}}
            {{#if this.origem}}
                <span class="portal-order-card-selo {{if this.origem.ifood 'is-ifood' 'is-sistema'}}">{{this.origem.sistema}}</span>
            {{else}}
                <span class="portal-order-card-selo is-portal">{{t "customer-portal.ui.entregas.card.portal"}}</span>
            {{/if}}
            <span class="portal-order-card-situacao"><Badge @status={{@order.status}} /></span>
        </div>

        <div class="portal-order-card-linha">
            <span class="portal-order-card-quem {{if this.procurandoMotoboy 'is-procurando'}}">
                {{#if this.motoboy}}
                    {{#if this.capacete}}
                        <img src={{this.capacete}} alt="" class="portal-order-card-capacete" />
                    {{else}}
                        <FaIcon @icon="helmet-safety" class="portal-order-card-capacete-icone" />
                    {{/if}}
                {{else if this.procurandoMotoboy}}
                    <FaIcon @icon="hourglass-half" />
                {{/if}}
                <span class="portal-order-card-quem-texto">
                    {{#if this.motoboy}}
                        <strong>{{this.motoboy.nome}}</strong> ·
                    {{else if this.procurandoMotoboy}}
                        <strong>{{t "customer-portal.ui.entregas.card.procurando-motoboy"}}</strong> ·
                    {{/if}}
                    {{#if this.cliente}}{{this.cliente}} · {{/if}}{{n-a (format-date-fns this.hora "HH:mm")}}
                </span>
            </span>
            {{!-- Entregas: cronômetro do prazo de entrega (relógio com o fundo na cor do estado: verde, amarelo, vermelho) --}}
            {{#if this.cronometro}}
                <div class="portal-order-card-prazo" title={{t "customer-portal.ui.entregas.card.prazo"}}>
                    <Badge @type={{this.tipoDoPrazo}} @icon="clock">{{this.cronometro.texto}}</Badge>
                </div>
            {{/if}}
        </div>
    </div>
</LinkTo>
