{{!-- Entregas: zoom pela roda do mouse e pelos botões + e − (criados no setupMap, no canto inferior direito) --}}
<section class="portal-order-map" {{did-update this.syncRoutePreview @draft @selectedOrder}}>
    <LeafletMap class="portal-order-leaflet" @lat={{this.center.latitude}} @lng={{this.center.longitude}} @zoom={{11}} @zoomControl={{false}} @scrollWheelZoom={{true}} @onLoad={{this.setupMap}} as |layers|>
        <layers.tile @url="https://tile.openstreetmap.org/{z}/{x}/{y}.png" />
        {{#each this.markers key="id" as |place|}}
            <layers.marker @lat={{place.latitude}} @lng={{place.longitude}} @icon={{place.icon}} as |marker|>
                <marker.tooltip @permanent={{true}} @direction="top" @className="portal-order-route-marker-tooltip">
                    <div class="text-xs font-semibold">{{place.label}}</div>
                </marker.tooltip>
                <marker.popup>
                    <div class="portal-order-marker-type {{place.type}} text-xs font-semibold uppercase">{{place.label}}</div>
                    <div class="text-sm font-semibold">{{n-a place.name}}</div>
                    <div class="text-xs">{{place-address place}}</div>
                    {{#if place.order}}
                        <div class="text-xs mt-1">{{or place.order.tracking_number.tracking_number place.order.public_id place.order.id}}</div>
                    {{else}}
                        <div class="text-xs mt-1">{{t "customer-portal.ui.order.new-order-route"}}</div>
                    {{/if}}
                </marker.popup>
            </layers.marker>
        {{/each}}
        {{!-- Entregas: alfinete vermelho no endereço de entrega de cada pedido em andamento da loja (PedidosNoMapa::daLoja), por baixo dos capacetes --}}
        {{#each this.alfinetes key="id" as |pedido|}}
            <layers.marker @lat={{pedido.latitude}} @lng={{pedido.longitude}} @icon={{this.iconeDoAlfinete}} @zIndexOffset={{-1000}} @riseOnHover={{true}} as |marker|>
                <marker.popup @minWidth="200">
                    <div class="text-sm font-semibold">{{pedido.numero}}</div>
                    <div class="text-xs"><span class="text-gray-500">{{t "customer-portal.ui.entregas.mapa-pedido-status"}}:</span> {{smart-humanize pedido.status}}</div>
                    <div class="text-xs"><span class="text-gray-500">{{t "customer-portal.ui.entregas.mapa-pedido-motoboy"}}:</span>
                        {{or pedido.motoboy (t "customer-portal.ui.entregas.mapa-pedido-sem-motoboy")}}</div>
                    <div class="text-xs"><span class="text-gray-500">{{t "customer-portal.ui.entregas.mapa-pedido-criado"}}:</span> {{this.tempoDoPedido pedido this.relogio}}</div>
                    <div class="text-xs"><span class="text-gray-500">{{t "customer-portal.ui.entregas.mapa-pedido-entrega"}}:</span> {{n-a pedido.endereco}}</div>
                    <LinkTo @route="portal.orders.details" @model={{pedido.id}} class="text-xs font-semibold mt-1 inline-block">{{t "customer-portal.ui.entregas.mapa-pedido-ver"}}</LinkTo>
                </marker.popup>
            </layers.marker>
        {{/each}}
    </LeafletMap>
</section>
