<div class="contents" {{did-insert this.initialize}} {{did-update this.refreshServiceQuotes this.quoteRevision}}>
    <Overlay @position="right" @noBackdrop={{true}} @fullHeight={{true}} @width="500px" @isOpen={{true}} @overlayClass="portal-order-panel-overlay" as |overlay|>
        <Overlay::Header @overlay={{overlay}} @title={{t "customer-portal.ui.order.new-order"}} @onPressCancel={{this.cancel}}>
            <:actions>
                <Button @icon="check" @type="primary" @text={{t "customer-portal.ui.common.create"}} @onClick={{this.submit}} @isLoading={{this.customerPortalOrderActions.createOrder.isRunning}} @disabled={{not this.canSubmit}} />
            </:actions>
        </Overlay::Header>
        <Overlay::Body @wrapperClass="portal-order-overlay-body">
            {{#if this.semCredito}}
                {{! Entregas: loja pré-paga sem crédito; o pedido continua liberado aqui, mas o servidor recusa }}
                <div class="entregas-carteira-alerta is-erro entregas-pedido-sem-credito" role="alert">
                    <FaIcon @icon="triangle-exclamation" />
                    <span>{{t "customer-portal.ui.entregas.carteira.sem-credito-pedido"}}</span>
                    <LinkTo @route="portal.carteira">{{t "customer-portal.ui.entregas.carteira.menu"}}</LinkTo>
                </div>
            {{/if}}
            {{!-- Entregas: só o destino (a coleta é a loja) e as observações. Sem tipo (vale o primeiro habilitado), agendamento, campos extras, itens, tarifas nem arquivos: o servidor descarta ou nega --}}
            <Portal::Order::Form::Route @draft={{this.draft}} @places={{@model.places}} @loja={{@model.loja}} />
            <Portal::Order::Form::Notes @draft={{this.draft}} />
            <Spacer @height="200px" />
        </Overlay::Body>
    </Overlay>
</div>
