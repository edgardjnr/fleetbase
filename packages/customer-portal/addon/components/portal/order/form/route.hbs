{{!-- Entregas: só o modo simples. Coleta fixa no endereço da loja (só leitura) e o destino escolhido entre os endereços salvos; sem várias paradas, sem retorno e sem editar endereço salvo --}}
<ContentPanel @title={{t "customer-portal.ui.order.route"}} @open={{true}} @actionButtons={{this.actionButtons}} @wrapperClass="bordered-top">
    <div class="grid grid-cols-1 gap-3">
        <InputGroup>
            <label class="text-xs font-semibold dark:text-gray-100 mb-1 block">{{t "customer-portal.ui.entregas.pickup-fixed"}}</label>
            {{#if @loja.coleta}}
                <div class="form-input bg-gray-50 dark:bg-gray-800">{{@loja.nome}}{{if @loja.endereco (concat " — " @loja.endereco)}}</div>
                <p class="text-xs text-gray-500 mt-1">{{t "customer-portal.ui.entregas.pickup-fixed-help"}}</p>
            {{else}}
                <p class="text-xs text-red-500">{{t "customer-portal.ui.entregas.store-without-address"}}</p>
            {{/if}}
        </InputGroup>
        <InputGroup>
            <div class="flex items-center justify-between mb-1">
                <label class="text-xs font-semibold dark:text-gray-100">
                    {{t "customer-portal.ui.order.dropoff"}}
                    <span class="text-red-500">*</span>
                </label>
            </div>
            <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                <PowerSelect
                    @options={{this.places}}
                    @search={{perform this.searchPlaces}}
                    @searchEnabled={{true}}
                    @selected={{@draft.payload.dropoff}}
                    @onChange={{fn this.setPayloadPlace "dropoff"}}
                    @placeholder={{t "customer-portal.ui.order.select-dropoff"}}
                    @allowClear={{true}}
                    @triggerClass="form-select form-input"
                    @renderInPlace={{true}}
                    as |place|
                >
                    {{place-address place}}
                </PowerSelect>
            </div>
            <p class="text-xs text-gray-500 mt-1">{{t "customer-portal.ui.entregas.customer-name-help"}}</p>
        </InputGroup>
    </div>
</ContentPanel>
