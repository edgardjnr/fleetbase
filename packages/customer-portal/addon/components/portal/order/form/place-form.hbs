<div class="portal-order-address-form">
    <div class="grid grid-cols-1 gap-3">
        <InputGroup @name={{t "customer-portal.ui.place.address-label"}}>
            <Input @value={{this.name}} class="form-input w-full" placeholder={{t "customer-portal.ui.place.address-label-placeholder"}} {{on "input" (fn this.setInput "name")}} />
        </InputGroup>

        <InputGroup @name={{t "customer-portal.ui.place.street-address"}} @required={{true}}>
            <Textarea @value={{this.street1}} class="form-input w-full" rows="3" placeholder={{t "customer-portal.ui.place.street-address-placeholder"}} {{on "input" (fn this.setInput "street1")}} />
        </InputGroup>

        <InputGroup @name={{t "customer-portal.ui.place.contact-phone"}}>
            <Input @value={{this.phone}} class="form-input w-full" placeholder={{t "customer-portal.ui.place.phone-placeholder"}} {{on "input" (fn this.setInput "phone")}} />
        </InputGroup>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <InputGroup @name={{t "customer-portal.ui.place.latitude"}}>
                <Input @value={{this.latitude}} class="form-input w-full" placeholder={{t "customer-portal.ui.common.optional"}} {{on "input" (fn this.setInput "latitude")}} />
            </InputGroup>
            <InputGroup @name={{t "customer-portal.ui.place.longitude"}}>
                <Input @value={{this.longitude}} class="form-input w-full" placeholder={{t "customer-portal.ui.common.optional"}} {{on "input" (fn this.setInput "longitude")}} />
            </InputGroup>
        </div>
    </div>

    <div class="flex items-center justify-end space-x-2 mt-4">
        <Button @text={{t "customer-portal.ui.common.cancel"}} @onClick={{@onCancel}} />
        <Button @type="primary" @text={{t "customer-portal.ui.place.save-address"}} @icon="check" @onClick={{this.save}} @isLoading={{@isSaving}} @disabled={{not this.canSave}} />
    </div>
</div>
