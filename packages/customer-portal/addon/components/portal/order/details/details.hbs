<ContentPanel @title={{t "customer-portal.ui.support.details"}} @open={{true}} @wrapperClass="bordered-top">
    <div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "customer-portal.ui.order.order-id"}}</div>
            <ClickToCopy @value={{@resource.public_id}} class="field-value">{{n-a @resource.public_id}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "customer-portal.ui.order.tracking-number"}}</div>
            <ClickToCopy @value={{@resource.tracking_number.tracking_number}} class="field-value">{{n-a @resource.tracking_number.tracking_number}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "customer-portal.ui.order.scheduled"}}</div>
            <div class="field-value">{{n-a (format-date-fns @resource.scheduled_at "MMM d, yyyy HH:mm")}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "customer-portal.ui.common.created"}}</div>
            <div class="field-value">{{n-a (format-date-fns @resource.created_at "MMM d, yyyy HH:mm")}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "customer-portal.ui.common.type"}}</div>
            <div class="field-value">{{n-a (smart-humanize @resource.type)}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "customer-portal.ui.order.proof-of-delivery"}}</div>
            <div class="field-value">{{if @resource.pod_required (smart-humanize @resource.pod_method) (t "customer-portal.ui.order.not-required")}}</div>
        </div>
        <div class="field-info-container field-vertical-container">
            <div class="field-name">{{t "customer-portal.ui.common.notes"}}</div>
            <div class="field-value">{{n-a @resource.notes (t "customer-portal.ui.order.no-notes")}}</div>
        </div>
    </div>
</ContentPanel>