<div class="portal-account-card">
    <div class="portal-section-header mb-4">
        <div>
            <h2 class="text-base font-bold">{{t "customer-portal.ui.settings.members"}}</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{t "customer-portal.ui.entregas.members-managed-by-central"}}</p>
        </div>
        {{#if this.isCompanyAccount}}
            <Button @type="default" @size="sm" @icon="rotate" @helpText={{t "customer-portal.ui.common.reload"}} @onClick={{perform this.loadPersonnel}} @isLoading={{this.loadPersonnel.isRunning}} />
        {{/if}}
    </div>

    {{#if this.isCompanyAccount}}
        <div class="portal-personnel-list">
            {{#if this.loadPersonnel.isRunning}}
                <div class="portal-widget-empty"><Spinner /></div>
            {{else if this.hasPersonnel}}
                {{#each this.personnels as |personnel|}}
                    <div class="portal-personnel-row">
                        <Image src={{personnel.photo_url}} @fallbackSrc={{config "defaultValues.contactImage"}} alt={{personnel.name}} class="portal-personnel-avatar" />
                        <div class="min-w-0">
                            <div class="portal-personnel-name">{{or personnel.name personnel.public_id}}</div>
                            <div class="portal-personnel-meta">{{n-a personnel.email}} {{n-a personnel.phone}}</div>
                        </div>
                        <div class="portal-personnel-role">{{this.roleLabel personnel.role}}</div>
                        <Badge @status={{or personnel.status "active"}} />
                    </div>
                {{/each}}
            {{else}}
                <div class="portal-widget-empty">{{t "customer-portal.ui.members.empty"}}</div>
            {{/if}}
        </div>
    {{/if}}
</div>
