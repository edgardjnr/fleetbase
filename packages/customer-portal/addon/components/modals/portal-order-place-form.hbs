<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <div class="grid grid-cols-3 gap-2 text-xs dark:text-gray-100 no-input-group-padding">
            <InputGroup @name={{t "customer-portal.ui.common.name"}} @wrapperClass="col-span-3">
                <Input @value={{this.place.name}} @type="text" class="w-full form-input" placeholder={{t "customer-portal.ui.common.name"}} />
            </InputGroup>

            <InputGroup @name={{t "customer-portal.ui.place.street1"}} @wrapperClass="col-span-3">
                {{! Entregas: sugestões do Google Places perto da loja (o servidor usa o Local da loja como referência) }}
                <EnderecoGoogleInput @value={{this.place.street1}} @onSelect={{this.onAutocomplete}} @placeholder={{t "customer-portal.ui.place.street1"}} />
            </InputGroup>

            <InputGroup @name={{t "customer-portal.ui.place.street2"}} @autocomplete="nope" @value={{this.place.street2}} @wrapperClass="col-span-3" />
            <InputGroup @name={{t "customer-portal.ui.place.neighborhood"}} @autocomplete="nope" @value={{this.place.neighborhood}} />
            <InputGroup @name={{t "customer-portal.ui.place.building"}} @autocomplete="nope" @value={{this.place.building}} />
            <InputGroup @name={{t "customer-portal.ui.place.security-access-code"}} @autocomplete="nope" @value={{this.place.security_access_code}} />
            <InputGroup @name={{t "customer-portal.ui.place.postal-code"}} @autocomplete="nope" @value={{this.place.postal_code}} />
            <InputGroup @name={{t "customer-portal.ui.place.city"}} @autocomplete="nope" @value={{this.place.city}} />
            <InputGroup @name={{t "customer-portal.ui.place.state"}} @autocomplete="nope" @value={{this.place.province}} />

            <InputGroup @name={{t "customer-portal.ui.place.country"}} @wrapperClass="col-span-2">
                <CountrySelect class="w-full form-input form-select form-datalist" @value={{this.place.country}} @onChange={{fn (mut this.place.country)}} placeholder={{t "customer-portal.ui.place.country"}} />
            </InputGroup>

            <InputGroup @name={{t "customer-portal.ui.place.coordinates"}} @wrapperClass="col-span-2">
                {{!-- Entregas: o mapa abre na loja (@options.mapCenter) e mais perto (zoom 15) --}}
                <ModelCoordinatesInput @model={{this.place}} @autocomplete="all" @onInputReady={{fn (mut this.coordinatesInput)}} @mapCenter={{@options.mapCenter}} @zoom={{15}} />
                {{!-- Entregas: o km da cobrança e do pagamento do motoboy sai deste ponto --}}
                <p class="text-xs text-gray-500 mt-1">{{t "customer-portal.ui.entregas.map-location-help"}}</p>
            </InputGroup>

            <InputGroup @name={{t "customer-portal.ui.address-book.phone"}} @wrapperClass="col-span-2">
                <PhoneInput @value={{this.place.phone}} @autocomplete="nope" @onInput={{fn (mut this.place.phone)}} class="form-input w-full" />
            </InputGroup>
        </div>
    </div>
</Modal::Default>
