<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    {{#if this.bundles}}
        <div class="next-table-wrapper auto-height">
            <table>
                <thead>
                    <tr>
                        <th {{set-width "175px"}}>ID</th>
                        <th {{set-width "70px"}}>{{t "registry-bridge.ui.bundle"}}</th>
                        <th {{set-width "80px"}}>{{t "registry-bridge.ui.version"}}</th>
                        <th {{set-width "110px"}}>{{t "registry-bridge.ui.uploaded"}}</th>
                        <th {{set-width "100px"}}>{{t "registry-bridge.ui.status"}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.bundles as |bundle|}}
                        <tr>
                            <td>{{bundle.bundle_id}}</td>
                            <td>{{bundle.bundle_number}}</td>
                            <td>{{bundle.version}}</td>
                            <td>{{bundle.createdAgo}}</td>
                            <td>
                                <Badge @status={{bundle.status}} />
                            </td>
                            <td>
                                {{#if (eq this.extension.next_bundle_uuid bundle.id)}}
                                    <div class="flex flex-row items-center text-xs">
                                        <FaIcon @icon="check" class="text-green-500" @size="md" />
                                        <span class="ml-2 text-green-400">{{t "registry-bridge.ui.selected"}}</span>
                                    </div>
                                {{else}}
                                    <Button @text={{t "registry-bridge.ui.select"}} @size="xs" @type="primary" @onClick={{fn this.selectBundle bundle}} />
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <div>{{t "registry-bridge.ui.no-bundles"}}</div>
    {{/if}}
</Modal::Default>