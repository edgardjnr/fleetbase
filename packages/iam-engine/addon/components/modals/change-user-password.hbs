<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="px-4 text-gray-900 dark:text-gray-50">
        <div class="mb-1 text-base font-semibold">
            {{t "iam.ui.change-password.heading" userName=this.user.name}}
        </div>
        <div class="text-sm mb-4">{{t "iam.ui.change-password.instructions"}}</div>
        <InputGroup>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <InputGroup @name={{t "iam.ui.change-password.new-password"}} @type="password" @value={{this.password}} @wrapperClass="mb-0i" />
                <InputGroup @name={{t "iam.ui.change-password.confirm-new-password"}} @type="password" @value={{this.confirmPassword}} @wrapperClass="mb-0i" />
            </div>
        </InputGroup>
        <InputGroup>
            <Checkbox @value={{this.sendCredentials}} @label={{t "iam.ui.change-password.send-credentials"}} @onToggle={{fn (mut this.sendCredentials)}} @alignItems="center" @labelClass="mb-0i" />
        </InputGroup>
    </div>
</Modal::Default>