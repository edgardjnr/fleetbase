<Widget::IamDashboardWidget @endpoint="identity-health" @title={{t "iam.ui.widgets.identity-health.title"}} @subtitle={{t "iam.ui.widgets.identity-health.subtitle"}} @icon="heart-pulse" as |data|>
    <div class="iam-stat-grid">
        <div class="iam-stat-card">
            <span>{{data.status.active}}</span>
            <small>{{t "iam.ui.widgets.identity-health.active"}}</small>
        </div>
        <div class="iam-stat-card">
            <span>{{data.status.pending}}</span>
            <small>{{t "iam.ui.widgets.identity-health.pending"}}</small>
        </div>
        <div class="iam-stat-card">
            <span>{{data.verification.unverified}}</span>
            <small>{{t "iam.ui.widgets.identity-health.unverified"}}</small>
        </div>
        <div class="iam-stat-card">
            <span>{{data.dormant.count}}</span>
            <small>{{t "iam.ui.widgets.identity-health.dormant"}}</small>
        </div>
    </div>
    <div class="iam-row-list mt-3">
        <div class="iam-row">
            <span>{{t "iam.ui.widgets.identity-health.mfa-coverage"}}</span>
            <strong>{{if data.mfa.available (concat data.mfa.value "%") (t "iam.ui.widgets.identity-health.unavailable")}}</strong>
        </div>
        <div class="iam-row">
            <span>{{t "iam.ui.widgets.identity-health.organization-2fa"}}</span>
            <strong>{{if data.mfa.company_enforced (t "iam.ui.widgets.identity-health.enforced") (if data.mfa.company_enabled (t "iam.ui.widgets.identity-health.enabled") (t "iam.ui.widgets.identity-health.off"))}}</strong>
        </div>
        <div class="iam-row">
            <span>{{t "iam.ui.widgets.identity-health.dormant-threshold"}}</span>
            <strong>{{t "iam.ui.widgets.days" count=data.dormant.threshold_days}}</strong>
        </div>
    </div>
</Widget::IamDashboardWidget>
