<div class="iam-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border shadow-sm" ...attributes>
    <div class="iam-widget-header">
        <div class="min-w-0">
            <div class="iam-widget-title">{{t "iam.ui.widgets.quick-actions.title"}}</div>
            <div class="iam-widget-subtitle">{{t "iam.ui.widgets.quick-actions.subtitle"}}</div>
        </div>
        <div class="iam-widget-icon"><FaIcon @icon="bolt" /></div>
    </div>
    <div class="iam-widget-body iam-report-body">
        <div class="iam-action-grid">
            <LinkTo @route="users" class="iam-action-link"><FaIcon @icon="user-plus" /><span>{{t "iam.ui.widgets.quick-actions.invite-user"}}</span></LinkTo>
            {{! Entregas RestaurantePro: sem Grupos (a rota groups saiu do routes.js) }}
            <LinkTo @route="roles" class="iam-action-link"><FaIcon @icon="user-tag" /><span>{{t "iam.ui.widgets.quick-actions.create-role"}}</span></LinkTo>
            <LinkTo @route="policies" class="iam-action-link"><FaIcon @icon="file-shield" /><span>{{t "iam.ui.widgets.quick-actions.create-policy"}}</span></LinkTo>
        </div>
    </div>
</div>
