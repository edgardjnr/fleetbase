<div class="flex items-center gap-2">
    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
        <PowerSelect
            @options={{this.exportOptions}}
            @selected={{this.format}}
            @onChange={{this.setFormat}}
            @placeholder={{t "ember-ui.report-builder.export-options.export-format"}}
            @triggerClass="form-select form-input form-input-sm"
            as |option|
        >
            {{option.label}}
        </PowerSelect>
    </div>
    <Button @text={{t "ember-ui.report-builder.export-options.export"}} @icon="download" @size="sm" @type="default" @disabled={{@disabled}} @onClick={{this.export}} />
</div>