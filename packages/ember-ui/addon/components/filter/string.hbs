<div class="filter-string" ...attributes>
    <Input @value={{this.value}} placeholder={{@placeholder}} {{on "input" this.onChange}} aria-label={{t "ember-ui.filter.string.filter-input"}} autocomplete="false" class="form-input form-input-sm flex-1" />
    <button type="button" class="clear-button" disabled={{not this.value}} alt={{t "ember-ui.filter.clear"}} {{on "click" this.clear}}>
        <FaIcon @icon="times" />
    </button>
</div>