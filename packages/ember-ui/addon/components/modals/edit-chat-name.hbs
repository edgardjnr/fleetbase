<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @type="text" @name={{t "ember-ui.modals.edit-chat-name.channel-name"}} @value={{@options.channelName}} @helpText={{t "ember-ui.modals.edit-chat-name.help-text"}} @inputClass="input-lg" />
    </div>
</Modal::Default>