{{!-- Entregas: rastreio para o cliente final (rota virtual /~/track-order), no visual da landing do console (classes ent-* em console/app/styles/landing.css e entregas-telas.css). Mesmos dados e ações do original: busca pelo código, mapa com o motoboy ao vivo e a rota, progresso, atividades e itens. --}}
<div class="ent-tema ent-rastreio">
    <header class="ent-rastreio-topo">
        <button type="button" class="ent-rastreio-marca" {{on "click" this.transitionToConsole}}>
            <LogoIcon @size="8" class="ent-marca-icone" />
            <span class="ent-marca-nome">Entregas</span>
        </button>
        {{#if this.order}}
            <button type="button" class="ent-botao-contorno" {{on "click" this.lookupAnother}}>{{t "fleet-ops.ui.component.order-tracking-lookup.outro-pedido"}}</button>
        {{/if}}
    </header>

    {{#if this.order}}
        {{#let this.order as |order|}}
            <div class="ent-rastreio-grade">
                <section class="ent-rastreio-resumo" aria-live="polite">
                    <p class="ent-rastreio-codigo">
                        <span>{{t "fleet-ops.ui.component.order-tracking-lookup.pedido"}}</span>
                        <ClickToCopy @value={{order.tracking_number.tracking_number}}>
                            <strong>{{order.tracking_number.tracking_number}}</strong>
                        </ClickToCopy>
                    </p>
                    <h1 class="ent-rastreio-status ent-rastreio-status-{{this.situacao}}">{{this.statusTexto}}</h1>
                    {{#if this.previsaoTexto}}
                        <p class="ent-rastreio-previsao">
                            {{t "fleet-ops.ui.component.order-tracking-lookup.previsao"}}
                            <strong>{{this.previsaoTexto}}</strong>
                        </p>
                    {{/if}}
                    {{#if this.criadoEm}}
                        <p class="ent-rastreio-criado">{{t "fleet-ops.ui.component.order-tracking-lookup.criado-em" data=this.criadoEm}}</p>
                    {{/if}}
                </section>

                <section class="ent-rastreio-mapa-bloco" aria-label={{t "fleet-ops.ui.component.order-tracking-lookup.mapa"}}>
                    <div class="ent-rastreio-mapa">
                        {{#if this.mapReady}}
                            <LeafletMap @lat={{this.latitude}} @lng={{this.longitude}} @zoom={{this.zoom}} @onLoad={{this.setupMap}} ...attributes as |layers|>
                                <layers.tile @url={{this.tileSourceUrl}} />
                                {{#let this.order.driver_assigned as |driver|}}
                                    {{#if driver}}
                                        <layers.tracking-marker
                                            @id={{driver.id}}
                                            @publicId={{driver.public_id}}
                                            @location={{driver.coordinates}}
                                            @rotationAngle={{0}}
                                            @icon={{icon iconUrl=this.capaceteUrl iconSize=(array 44 44) iconAnchor=(array 22 22)}}
                                            @onAdd={{this.startTrackingDriverPosition}}
                                            as |marker|
                                        >
                                            <marker.tooltip @permanent={{true}} @direction="bottom" @offset={{array 0 18}} @className="ent-rastreio-nome">
                                                {{driver.name}}
                                            </marker.tooltip>
                                        </layers.tracking-marker>
                                    {{/if}}
                                {{/let}}
                            </LeafletMap>
                        {{else}}
                            <div class="ent-rastreio-mapa-vazio" aria-hidden="true"></div>
                        {{/if}}
                    </div>
                    <div class="ent-rastreio-mapa-acoes">
                        <button type="button" class="ent-botao-contorno" disabled={{not this.mapReady}} {{on "click" this.locateOrderRoute}}>{{t "fleet-ops.ui.component.order-tracking-lookup.ver-rota"}}</button>
                        <button type="button" class="ent-botao-contorno" disabled={{or (not this.mapReady) (not order.has_driver_assigned)}} {{on "click" this.locateDriver}}>{{t "fleet-ops.ui.component.order-tracking-lookup.ver-motoboy"}}</button>
                    </div>
                </section>

                <div class="ent-rastreio-detalhes">
                    <section class="ent-rastreio-bloco ent-rastreio-motoboy">
                        <img src={{this.capaceteUrl}} alt="" width="48" height="48" />
                        {{#if order.driver_assigned}}
                            <div>
                                <p class="ent-rastreio-rotulo">{{t "fleet-ops.ui.component.order-tracking-lookup.seu-motoboy"}}</p>
                                <p class="ent-rastreio-motoboy-nome">{{order.driver_assigned.name}}</p>
                            </div>
                        {{else}}
                            <div>
                                <p class="ent-rastreio-rotulo">{{t "fleet-ops.ui.component.order-tracking-lookup.seu-motoboy"}}</p>
                                <p class="ent-rastreio-motoboy-nome ent-rastreio-apagado">{{t "fleet-ops.ui.component.order-tracking-lookup.sem-motoboy"}}</p>
                            </div>
                        {{/if}}
                    </section>

                    <section class="ent-rastreio-bloco">
                        <h2 class="ent-rastreio-h2">{{t "fleet-ops.ui.component.order-tracking-lookup.andamento"}}</h2>
                        <div class="ent-rastreio-progresso">
                            <OrderProgressBar
                                @order={{this.order}}
                                @progress={{this.order.tracker_data.progress.percentage}}
                                @firstWaypointCompleted={{gt this.order.tracker_data.progress.completed_stops 0}}
                                @lastWaypointCompleted={{eq this.order.tracker_data.progress.percentage 100}}
                            />
                        </div>
                        <dl class="ent-rastreio-dados">
                            {{#if this.order.tracker_data.active_stop.address}}
                                <div>
                                    <dt>{{t "fleet-ops.ui.component.order-tracking-lookup.indo-para"}}</dt>
                                    <dd>{{this.order.tracker_data.active_stop.address}}</dd>
                                </div>
                            {{/if}}
                            {{#if this.order.tracker_data.next_stop.address}}
                                <div>
                                    <dt>{{t "fleet-ops.ui.component.order-tracking-lookup.depois"}}</dt>
                                    <dd>{{this.order.tracker_data.next_stop.address}}</dd>
                                </div>
                            {{/if}}
                            {{#if this.conclusaoPrevista}}
                                <div>
                                    <dt>{{t "fleet-ops.ui.component.order-tracking-lookup.conclusao-prevista"}}</dt>
                                    <dd>{{this.conclusaoPrevista}}</dd>
                                </div>
                            {{/if}}
                        </dl>
                    </section>

                    <section class="ent-rastreio-bloco">
                        <h2 class="ent-rastreio-h2">{{t "fleet-ops.ui.component.order-tracking-lookup.historico"}}</h2>
                        <ol class="ent-rastreio-linha">
                            {{#each order.tracking_statuses as |trackingStatus|}}
                                <li>
                                    <p class="ent-rastreio-linha-titulo">{{tracking-status-text trackingStatus.status}}</p>
                                    {{#if trackingStatus.details}}
                                        <p class="ent-rastreio-linha-texto">{{tracking-status-text trackingStatus.details "details"}}</p>
                                    {{/if}}
                                    <p class="ent-rastreio-linha-hora">{{trackingStatus.createdAtShortWithTime}}</p>
                                </li>
                            {{else}}
                                <li class="ent-rastreio-apagado">{{t "order.fields.no-order-activity"}}</li>
                            {{/each}}
                        </ol>
                    </section>

                    {{#if this.itens.length}}
                        <section class="ent-rastreio-bloco">
                            <h2 class="ent-rastreio-h2">{{t "fleet-ops.ui.component.order-tracking-lookup.itens-do-pedido"}}</h2>
                            <ul class="ent-rastreio-itens">
                                {{#each this.itens as |entity index|}}
                                    <li>
                                        {{#if entity.photo_url}}
                                            <Image src={{entity.photo_url}} class="ent-rastreio-item-foto" alt={{entity.name}} />
                                        {{/if}}
                                        <div>
                                            <p class="ent-rastreio-item-nome">{{n-a entity.name (concat (t "fleet-ops.ui.component.order-tracking-lookup.item") (add index 1))}}</p>
                                            {{#if entity.description}}
                                                <p class="ent-rastreio-linha-texto">{{entity.description}}</p>
                                            {{/if}}
                                        </div>
                                        {{#if entity.price}}
                                            <p class="ent-rastreio-item-preco">{{format-currency entity.price entity.currency}}</p>
                                        {{/if}}
                                    </li>
                                {{/each}}
                            </ul>
                        </section>
                    {{/if}}
                </div>
            </div>
        {{/let}}
    {{else}}
        <main class="ent-rastreio-busca">
            <img class="ent-rastreio-busca-capacete" src="/images/entregas/capacete-vermelho.png" alt="" width="72" height="72" />
            <h1 class="ent-rastreio-busca-titulo">{{t "fleet-ops.ui.component.order-tracking-lookup.titulo"}}</h1>
            <p class="ent-rastreio-busca-lead">{{t "fleet-ops.ui.component.order-tracking-lookup.ajuda"}}</p>
            <form class="ent-rastreio-busca-form" {{on "submit" this.buscar}}>
                <label class="ent-campo" for="ent-rastreio-codigo">
                    <span class="ent-rotulo">{{t "fleet-ops.ui.component.order-tracking-lookup.codigo"}}</span>
                    <Input
                        id="ent-rastreio-codigo"
                        @value={{this.trackingNumber}}
                        class="ent-input ent-input-grande"
                        autocomplete="off"
                        autocapitalize="off"
                        spellcheck="false"
                        disabled={{this.lookupOrder.isRunning}}
                    />
                </label>
                <button type="submit" class="ent-botao ent-botao-tinta ent-botao-ui ent-botao-cheio" disabled={{or (not this.trackingNumber) this.lookupOrder.isRunning}} aria-busy={{if this.lookupOrder.isRunning "true" "false"}}>
                    {{#if this.lookupOrder.isRunning}}
                        <span class="ent-giro" aria-hidden="true"></span>
                        {{t "fleet-ops.ui.component.order-tracking-lookup.buscando"}}
                    {{else}}
                        {{t "fleet-ops.ui.component.order-tracking-lookup.rastrear"}}
                    {{/if}}
                </button>
            </form>
        </main>
    {{/if}}
</div>
