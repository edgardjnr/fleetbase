<div class="next-content-panel-wrapper" ...attributes>

    {{! ===== OVERVIEW ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.equipment.details.overview"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            {{! — Photo — }}
            {{#if (or @resource.photo_url (config "defaultValues.placeholderImage"))}}
                <div class="col-span-2 flex items-start gap-3 pb-2">
                    <div class="border border-dashed border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-600 rounded-lg flex items-center justify-center w-16 h-16 flex-shrink-0">
                        <Image
                            alt={{@resource.name}}
                            src={{or @resource.photo_url (config "defaultValues.placeholderImage")}}
                            @fallbackSrc={{config "defaultValues.placeholderImage"}}
                            class="w-12 h-12 object-contain"
                        />
                    </div>
                    <div>
                        <p class="font-semibold text-sm text-gray-800 dark:text-gray-100">{{n-a @resource.name}}</p>
                        <p class="text-[11px] text-gray-400 dark:text-gray-500 font-mono">{{n-a @resource.public_id}}</p>
                    </div>
                </div>
            {{/if}}

            {{! — Identity & Classification — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "fleet-ops.ui.equipment.details.identity-classification"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">ID</div>
                <ClickToCopy @value={{@resource.public_id}} class="field-value font-mono">{{n-a @resource.public_id}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.code"}}</div>
                <ClickToCopy @value={{@resource.code}} class="field-value font-mono">{{n-a @resource.code}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.name"}}</div>
                <div class="field-value">{{n-a @resource.name}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.type"}}</div>
                <div class="field-value">{{n-a (smart-humanize @resource.type)}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.status"}}</div>
                <div class="field-value">
                    <Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge>
                </div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.serial-number"}}</div>
                <div class="field-value font-mono">{{n-a @resource.serial_number}}</div>
            </div>

            {{! — Make & Model — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.equipment.details.make-model"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.manufacturer"}}</div>
                <div class="field-value">{{n-a @resource.manufacturer}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.model"}}</div>
                <div class="field-value">{{n-a @resource.model}}</div>
            </div>

            {{! — Assignment — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.equipment.details.assignment"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.equipped-status"}}</div>
                <div class="field-value">
                    {{#if @resource.is_equipped}}
                        <Badge @status="success">{{t "fleet-ops.ui.equipment.details.equipped"}}</Badge>
                    {{else}}
                        <Badge @status="default">{{t "fleet-ops.ui.equipment.details.not-equipped"}}</Badge>
                    {{/if}}
                </div>
            </div>
            {{#if @resource.is_equipped}}
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.equipment.details.equipped-to"}}</div>
                    <div class="field-value">{{n-a @resource.equipped_to_name}}</div>
                </div>
            {{/if}}
        </div>
    </ContentPanel>

    {{! ===== FINANCIALS ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.equipment.details.financials"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.purchase-price"}}</div>
                <div class="field-value">{{format-currency @resource.purchase_price @resource.currency}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.purchased-at"}}</div>
                <div class="field-value">{{n-a (format-date-fns @resource.purchased_at "dd MMM yyyy")}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.age"}}</div>
                <div class="field-value">{{n-a @resource.age_in_days}} {{t "fleet-ops.ui.equipment.details.days"}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.depreciated-value"}}</div>
                <div class="field-value">{{format-currency @resource.depreciated_value @resource.currency}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.equipment.details.currency"}}</div>
                <div class="field-value">{{n-a @resource.currency}}</div>
            </div>
        </div>
    </ContentPanel>

    {{! ===== WARRANTY ===== }}
    {{#if @resource.warranty_name}}
        <ContentPanel @title={{t "fleet-ops.ui.equipment.details.warranty"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.equipment.details.warranty"}}</div>
                    <div class="field-value">{{n-a @resource.warranty_name}}</div>
                </div>
            </div>
        </ContentPanel>
    {{/if}}

    {{! ===== CUSTOM FIELDS ===== }}
    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />

    <Spacer @height="200px" />
</div>