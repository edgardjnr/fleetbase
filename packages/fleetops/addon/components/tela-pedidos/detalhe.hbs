{{! Entregas: detalhe do pedido escolhido na vista Mapa (cartão junto ao painel Pedidos; no celular, dentro da folha). }}
<div class="tp-detalhe-conteudo">
    <div class="tp-detalhe-topo">
        <b class="tp-detalhe-numero">{{@pedido.numeroTexto}}</b>
        {{#if @pedido.ifood}}<span class="tp-selo tp-selo-ifood">iFood</span>{{/if}}
        {{#if @pedido.prazo}}<span class="tp-prazo tp-prazo-{{@pedido.prazo.estado}}"><FaIcon @icon="clock" /> {{@pedido.prazo.texto}}</span>{{/if}}
        <button type="button" class="tp-icone tp-fechar" aria-label={{t "fleet-ops.ui.tela-pedidos.detalhe.fechar"}} {{on "click" @aoFechar}}><FaIcon @icon="xmark" /></button>
    </div>
    <div class="tp-detalhe-rota">
        <FaIcon @icon="store" /><span><b>{{@pedido.loja}}</b></span>
        <FaIcon @icon="location-dot" class="tp-cor-cliente" /><span>{{@pedido.endereco}}</span>
    </div>
    {{#if @pedido.ehOferta}}
        <p class="tp-texto-oferta"><FaIcon @icon="tower-broadcast" /> {{@pedido.textoDaOferta}}</p>
    {{/if}}
    {{#if @pedido.motoboyDoPedido}}
        <div class="tp-detalhe-motoboy">
            <img src={{@pedido.motoboyDoPedido.capacete}} alt="" />
            <span><b>{{@pedido.motoboyDoPedido.nome}}</b><small>{{@pedido.textoDaSituacao}} · {{t "fleet-ops.ui.tela-pedidos.corridas-hoje" n=(or @pedido.motoboyDoPedido.corridas_hoje 0)}}</small></span>
        </div>
    {{else if @pedido.motoboy}}
        <div class="tp-detalhe-motoboy"><img src={{@pedido.capacete}} alt="" /><span><b>{{@pedido.motoboy}}</b><small>{{@pedido.textoDaSituacao}}</small></span></div>
    {{/if}}
    <div class="tp-detalhe-acoes">
        <button type="button" class="tp-botao tp-botao-contorno tp-pequeno" {{on "click" (fn @aoAbrir @pedido.id)}}><FaIcon @icon="up-right-from-square" /> {{t "fleet-ops.ui.tela-pedidos.detalhe.abrir"}}</button>
        {{#if @ehAdmin}}
            <button type="button" class="tp-botao {{if @pedido.ehOferta 'tp-botao-marca' 'tp-botao-contorno'}} tp-pequeno" aria-expanded={{if @pedido.aberto "true" "false"}} {{on "click" (fn @aoAlternarAtribuir @pedido.id)}}>
                <FaIcon @icon={{if @pedido.ehOferta "user-plus" "right-left"}} />
                {{if @pedido.ehOferta (t "fleet-ops.ui.painel-inicial.atribuir.botao") (t "fleet-ops.ui.tela-pedidos.detalhe.trocar")}}
            </button>
        {{/if}}
    </div>
    {{#if @pedido.aberto}}
        <div class="tp-candidatos">
            {{#each @pedido.candidatos key="id" as |motoboy|}}
                <div class="tp-candidato">
                    <img src={{@capaceteLivre}} alt="" />
                    <span><b>{{motoboy.nome}}</b><small>{{motoboy.kmTexto}} · {{motoboy.corridasTexto}}</small></span>
                    <button type="button" class="tp-botao tp-botao-marca tp-pequeno" disabled={{@enviando}} {{on "click" (fn @aoEnviar @pedido.id motoboy.id)}}>{{t "fleet-ops.ui.painel-inicial.atribuir.enviar"}}</button>
                </div>
            {{else}}
                <p class="tp-nota">{{t "fleet-ops.ui.painel-inicial.atribuir.ninguem-livre"}}</p>
            {{/each}}
            <p class="tp-nota"><FaIcon @icon="circle-info" /> {{if @pedido.ehOferta (t "fleet-ops.ui.painel-inicial.atribuir.nota") (t "fleet-ops.ui.tela-pedidos.detalhe.nota-troca")}}</p>
        </div>
    {{/if}}
</div>
