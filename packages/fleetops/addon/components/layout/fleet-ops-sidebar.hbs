<Layout::Sidebar::Navigator
    @items={{this.navigationItems}}
    @primaryAction={{this.createOrderAction}}
    @searchPlaceholder={{t "fleet-ops.ui.layout.fleet-ops-sidebar.search-fleet-ops"}}
    @searchProvider={{this.searchNavigation}}
    @shouldSyncInitialActiveParent={{this.shouldSyncInitialActiveParent}}
    @plano={{true}}
    class="fleet-ops-sidebar-navigator"
>
    <:footer as |state|>
        {{! Entregas: a lista "Operações ao vivo" saiu do menu (trilho de ícones, sketch 006); os motoboys ao vivo ficam no
            painel Motoboys da tela de pedidos e no painel inicial }}
        {{#each (get this.footerRegistryComponents (or state.currentParent.id "root")) as |menuItem|}}
            {{component menuItem.component}}
        {{/each}}
    </:footer>
</Layout::Sidebar::Navigator>

{{yield}}
<Spacer @height="10px" />
