<div class="next-content-panel-wrapper" ...attributes>

    {{! ===== OVERVIEW ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.work-order.details.overview"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            {{! — Identity — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "fleet-ops.ui.work-order.details.identity"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.code"}}</div>
                <ClickToCopy @value={{@resource.code}} class="field-value font-mono">{{n-a @resource.code}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">ID</div>
                <ClickToCopy @value={{@resource.public_id}} class="field-value font-mono">{{n-a @resource.public_id}}</ClickToCopy>
            </div>
            <div class="field-info-container col-span-2">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.subject"}}</div>
                <div class="field-value">{{n-a @resource.subject}}</div>
            </div>
            <div class="field-info-container col-span-2">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.category"}}</div>
                <div class="field-value">{{n-a (smart-humanize @resource.category)}}</div>
            </div>

            {{! — Status & Priority — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.work-order.details.status-priority"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.status"}}</div>
                <div class="field-value">
                    <Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge>
                </div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.priority"}}</div>
                <div class="field-value">
                    {{#if (eq @resource.priority "critical")}}
                        <Badge @status="danger">{{t "fleet-ops.ui.work-order.details.critical"}}</Badge>
                    {{else if (eq @resource.priority "high")}}
                        <Badge @status="warning">{{t "fleet-ops.ui.work-order.details.high"}}</Badge>
                    {{else if (eq @resource.priority "medium")}}
                        <Badge @status="info">{{t "fleet-ops.ui.work-order.details.medium"}}</Badge>
                    {{else}}
                        <Badge @status="default">{{t "fleet-ops.ui.work-order.details.low"}}</Badge>
                    {{/if}}
                </div>
            </div>

            {{! — Assignment — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.work-order.details.assignment"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.target-asset"}}</div>
                <div class="field-value">{{n-a (or @resource.target.displayName @resource.target.name @resource.target_name)}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.assigned-vendor"}}</div>
                <div class="field-value">{{n-a (or @resource.assignee.displayName @resource.assignee.name @resource.assignee_name)}}</div>
            </div>
            {{#if @resource.schedule}}
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.linked-schedule"}}</div>
                    <div class="field-value">{{n-a @resource.schedule.name}}</div>
                </div>
            {{/if}}

            {{! — Scheduling — }}
            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.work-order.details.scheduling"}}
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.opened-at"}}</div>
                <div class="field-value">{{n-a (format-date-fns @resource.opened_at "dd MMM yyyy, HH:mm")}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.due-at"}}</div>
                <div class="field-value">{{n-a (format-date-fns @resource.due_at "dd MMM yyyy, HH:mm")}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.closed-at"}}</div>
                <div class="field-value">{{n-a (format-date-fns @resource.closed_at "dd MMM yyyy, HH:mm")}}</div>
            </div>
        </div>
    </ContentPanel>

    {{! ===== BUDGET ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.work-order.details.budget"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.estimated-cost"}}</div>
                <div class="field-value">{{format-currency @resource.estimated_cost @resource.currency}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.approved-budget"}}</div>
                <div class="field-value">{{format-currency @resource.approved_budget @resource.currency}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.actual-cost"}}</div>
                <div class="field-value font-semibold">{{format-currency @resource.actual_cost @resource.currency}}</div>
            </div>
            {{#if @resource.cost_center}}
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.cost-centre"}}</div>
                    <div class="field-value">{{n-a @resource.cost_center}}</div>
                </div>
            {{/if}}
            {{#if @resource.budget_code}}
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.budget-code"}}</div>
                    <div class="field-value font-mono">{{n-a @resource.budget_code}}</div>
                </div>
            {{/if}}
            <div class="field-info-container">
                <div class="field-name">{{t "fleet-ops.ui.work-order.details.currency"}}</div>
                <div class="field-value">{{n-a @resource.currency}}</div>
            </div>
        </div>
    </ContentPanel>

    {{! ===== INSTRUCTIONS ===== }}
    {{#if @resource.instructions}}
        <ContentPanel @title={{t "fleet-ops.ui.work-order.details.instructions"}} @open={{false}} @wrapperClass="bordered-top">
            <div class="text-xs text-gray-700 dark:text-gray-300 whitespace-pre-wrap">
                {{@resource.instructions}}
            </div>
        </ContentPanel>
    {{/if}}

    {{! ===== COMPLETION & COST BREAKDOWN (only when closed) ===== }}
    {{#if (eq @resource.status "closed")}}
        <ContentPanel @title={{t "fleet-ops.ui.work-order.details.completion-cost-breakdown"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

                <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                    {{t "fleet-ops.ui.work-order.details.asset-readings-at-completion"}}
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.odometer"}}</div>
                    <div class="field-value">
                        {{#if @resource.meta.completion_data.odometer}}
                            {{@resource.meta.completion_data.odometer}}
                            km
                        {{else}}
                            —
                        {{/if}}
                    </div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.engine-hours"}}</div>
                    <div class="field-value">{{n-a @resource.meta.completion_data.engine_hours}}</div>
                </div>

                <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                    {{t "fleet-ops.ui.work-order.details.cost-breakdown"}}
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.labour-cost"}}</div>
                    <div class="field-value">{{format-currency @resource.meta.completion_data.labor_cost @resource.meta.completion_data.currency}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.parts-cost"}}</div>
                    <div class="field-value">{{format-currency @resource.meta.completion_data.parts_cost @resource.meta.completion_data.currency}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleet-ops.ui.work-order.details.tax"}}</div>
                    <div class="field-value">{{format-currency @resource.meta.completion_data.tax @resource.meta.completion_data.currency}}</div>
                </div>
                <div class="field-info-container col-span-2 border-t border-gray-200 dark:border-gray-700 pt-2 mt-1">
                    <div class="field-name font-semibold">{{t "fleet-ops.ui.work-order.details.total-cost"}}</div>
                    <div class="field-value font-semibold">{{format-currency @resource.meta.completion_data.total_cost @resource.meta.completion_data.currency}}</div>
                </div>

                {{#if @resource.meta.completion_data.notes}}
                    <div class="field-info-container col-span-2 mt-2">
                        <div class="field-name">{{t "fleet-ops.ui.work-order.details.completion-notes"}}</div>
                        <div class="field-value whitespace-pre-wrap">{{@resource.meta.completion_data.notes}}</div>
                    </div>
                {{/if}}
            </div>
        </ContentPanel>
    {{/if}}

    {{! ===== CUSTOM FIELDS ===== }}
    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />

    <Spacer @height="200px" />
</div>
