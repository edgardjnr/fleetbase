<div class="part-form" ...attributes>

    {{! ===== IDENTIFICATION (includes photo, matching vehicle/form convention) ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.part.form.identification"}} @open={{true}} @wrapperClass="bordered-top">
        {{! Photo row — identical structure to vehicle/form UploadButton pattern }}
        <div class="flex flex-row space-x-3 mb-3">
            <div class="flex items-center justify-start rounded-full">
                <Image
                    src={{@resource.photo_url}}
                    @fallbackSrc={{config "defaultValues.placeholderImage"}}
                    alt={{@resource.name}}
                    height="48"
                    width="48"
                    class="h-14 w-14 rounded-full shadow-sm"
                />
                <Attach::Tooltip @class="clean" @animation="scale" @placement="top">
                    <InputInfo @text={{t "fleet-ops.ui.part.form.upload-a-new-photo"}} />
                </Attach::Tooltip>
            </div>
            <div>
                <UploadButton
                    @name={{t "fleet-ops.ui.part.form.photos"}}
                    @accept="image/*"
                    @onFileAdded={{perform this.handlePhotoUpload}}
                    @icon="upload"
                    @size="xs"
                    @buttonText={{t "fleet-ops.ui.part.form.upload-image"}}
                    @disabled={{cannot-write @resource}}
                />
                <div class="px-1">
                    <span class="text-gray-300 dark:text-gray-600 text-xs">{{t "fleet-ops.ui.part.form.supports-jpg-png-gif-up-to"}}</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            {{! Part Identification }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "fleet-ops.ui.part.form.part-details"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.name"}}>
                <Input @value={{@resource.name}} @type="text" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.part-name"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name="SKU">
                <Input @value={{@resource.sku}} @type="text" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.stock-keeping-unit"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.ui.part.form.serial-number"}}>
                <Input @value={{@resource.serial_number}} @type="text" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.serial-number-2"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.ui.part.form.barcode"}}>
                <Input @value={{@resource.barcode}} @type="text" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.barcode-or-qr-code-value"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.ui.part.form.manufacturer"}}>
                <Input @value={{@resource.manufacturer}} @type="text" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.manufacturer-name"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.ui.part.form.model"}}>
                <Input @value={{@resource.model}} @type="text" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.model-designation"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            {{! Type & Status }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.part.form.type-status"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.partTypeOptions}}
                        @selected={{@resource.type}}
                        @onChange={{fn (mut @resource.type)}}
                        @placeholder={{t "fleet-ops.ui.part.form.select-part-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |type|
                    >
                        {{smart-humanize type}}
                    </PowerSelect>
                </div>
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.ui.part.form.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.statusOptions}}
                        @selected={{@resource.status}}
                        @onChange={{fn (mut @resource.status)}}
                        @placeholder={{t "fleet-ops.ui.part.form.select-status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |status|
                    >
                        {{smart-humanize status}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "fleet-ops.ui.part.form.description"}} @wrapperClass="col-span-2">
                <Textarea
                    @value={{@resource.description}}
                    aria-label={{t "fleet-ops.ui.part.form.description"}}
                    class="w-full form-input"
                    disabled={{cannot-write @resource}}
                    placeholder={{t "fleet-ops.ui.part.form.part-description-and-usage-notes"}}
                    rows={{3}}
                />
            </InputGroup>
        </div>
    </ContentPanel>

    {{! ===== INVENTORY ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.part.form.inventory"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "fleet-ops.ui.part.form.stock-levels"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.quantity-on-hand"}}>
                <Input @value={{@resource.quantity_on_hand}} @type="number" class="w-full form-input" placeholder={{t "fleet-ops.ui.part.form.current-stock-quantity"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.part.form.pricing"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.currency"}}>
                <CurrencySelect @currency={{@resource.currency}} @onCurrencyChange={{fn (mut @resource.currency)}} @triggerClass="w-full form-select" @disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.ui.part.form.unit-cost"}}>
                <MoneyInput
                    class="w-full"
                    @value={{@resource.unit_cost}}
                    @currency={{or @resource.currency "USD"}}
                    @onChange={{fn (mut @resource.unit_cost)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>
            <InputGroup @name="MSRP">
                <MoneyInput class="w-full" @value={{@resource.msrp}} @currency={{or @resource.currency "USD"}} @onChange={{fn (mut @resource.msrp)}} @disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>

    {{! ===== COMPATIBILITY ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.part.form.compatibility"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "fleet-ops.ui.part.form.compatible-asset"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.asset-type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.assetTypeOptions}}
                        @selected={{this.selectedAssetType}}
                        @onChange={{this.onAssetTypeChange}}
                        @placeholder={{t "fleet-ops.ui.part.form.select-compatible-asset-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>
            {{#if this.assetModelName}}
                <InputGroup @name={{t "fleet-ops.ui.part.form.asset"}}>
                    <ModelSelect
                        @modelName={{this.assetModelName}}
                        @selectedModel={{@resource.asset}}
                        @placeholder={{t "fleet-ops.ui.part.form.select-compatible-asset"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.assignAsset}}
                        @disabled={{cannot-write @resource}}
                        as |model|
                    >
                        {{or model.name model.public_id}}
                    </ModelSelect>
                </InputGroup>
            {{/if}}
        </div>
    </ContentPanel>

    {{! ===== VENDOR & WARRANTY ===== }}
    <ContentPanel @title={{t "fleet-ops.ui.part.form.vendor-warranty"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "fleet-ops.ui.part.form.supplier"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.vendor"}} @wrapperClass="col-span-2">
                <ModelSelect
                    @modelName="vendor"
                    @selectedModel={{@resource.vendor}}
                    @placeholder={{t "fleet-ops.ui.part.form.select-vendor"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{fn (mut @resource.vendor)}}
                    @onChangeId={{fn (mut @resource.vendor_uuid)}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "fleet-ops.ui.part.form.warranty"}}
            </div>
            <InputGroup @name={{t "fleet-ops.ui.part.form.warranty"}} @wrapperClass="col-span-2">
                <ModelSelect
                    @modelName="warranty"
                    @selectedModel={{@resource.warranty}}
                    @placeholder={{t "fleet-ops.ui.part.form.select-warranty-optional"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{fn (mut @resource.warranty)}}
                    @onChangeId={{fn (mut @resource.warranty_uuid)}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.policy_number}}
                    -
                    {{model.provider}}
                </ModelSelect>
            </InputGroup>
        </div>
    </ContentPanel>

    {{! ===== REGISTRY & METADATA ===== }}
    <RegistryYield @registry="fleet-ops:component:part:form:details" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>
    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />
    <RegistryYield @registry="fleet-ops:component:part:form" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>
    <ContentPanel @title={{t "fleet-ops.ui.part.form.metadata"}} @open={{false}} @wrapperClass="bordered-top">
        <MetadataEditor @value={{@resource.meta}} @onChange={{fn (mut @resource.meta)}} />
    </ContentPanel>
</div>