<Layout::Resource::Tabular
    @resource="work-order"
    @title={{t "resource.work-orders"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.workOrderActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="clipboard-list"
        title=(t "fleet-ops.ui.route.maintenance-work-orders-index.no-work-orders-yet")
        description=(t "fleet-ops.ui.route.maintenance-work-orders-index.create-work-orders-to-assign-maintenance")
        filteredTitle=(t "fleet-ops.ui.route.maintenance-work-orders-index.no-work-orders-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.maintenance-work-orders-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.maintenance-work-orders-index.new-work-order")
        primaryIcon="plus"
        primaryAction=this.workOrderActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.maintenance-work-orders-index.import")
        secondaryIcon="upload"
        secondaryAction=this.workOrderActions.import
        docsSlug="fleet-ops/maintenance/work-orders/overview"
        docsTitle=(t "fleet-ops.ui.route.maintenance-work-orders-index.work-orders-guide")
        docsText=(t "fleet-ops.ui.route.maintenance-work-orders-index.work-orders-guide")
        docsSource="fleet-ops-empty-work-orders"
    }}
/>
{{outlet}}
