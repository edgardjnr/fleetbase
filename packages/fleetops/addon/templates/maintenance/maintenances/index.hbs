<Layout::Resource::Tabular
    @resource="maintenance"
    @title={{t "resource.maintenances"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.maintenanceActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="screwdriver-wrench"
        title=(t "fleet-ops.ui.route.maintenance-maintenances-index.no-maintenance-records-yet")
        description=(t "fleet-ops.ui.route.maintenance-maintenances-index.log-maintenance-events-to-keep-service")
        filteredTitle=(t "fleet-ops.ui.route.maintenance-maintenances-index.no-maintenance-records-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.maintenance-maintenances-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.maintenance-maintenances-index.new-maintenance")
        primaryIcon="plus"
        primaryAction=this.maintenanceActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.maintenance-maintenances-index.import")
        secondaryIcon="upload"
        secondaryAction=this.maintenanceActions.import
    }}
/>
{{outlet}}
