{{#if (eq this.layout "calendar")}}
    {{! ===== CALENDAR VIEW ===== }}
    {{! @events receives a function (fetchInfo, successCallback, failureCallback) — }}
    {{! FullCalendar v6 calls it automatically on render and navigation. }}
    <Layout::Section::Header @title={{t "resource.maintenance-schedules"}} @actionsWrapperClass="space-x-1">
        <Layout::Resource::TabularActions
            @searchQuery={{this.query}}
            @onSearch={{perform this.scheduleActions.controllerSearchTask this}}
            @columns={{this.columns}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @actionButtons={{this.actionButtons}}
            @bulkActions={{this.bulkActions}}
            @controller={{this}}
            @hideColumnsPicker={{true}}
        />
    </Layout::Section::Header>

    <Layout::Section::Body class="overflow-y-scroll-i h-full">
        <div class="p-4">
            <FullCalendar @events={{this.calendarEventSource}} @onEventClick={{this.onCalendarEventClick}} @onInit={{this.setCalendarApi}} />
        </div>
    </Layout::Section::Body>
{{else}}
    {{! ===== LIST VIEW (default) ===== }}
    <Layout::Resource::Tabular
        @resource="maintenance-schedule"
        @title={{t "resource.maintenance-schedules"}}
        @searchQuery={{this.query}}
        @onSearch={{perform this.scheduleActions.controllerSearchTask this}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        @actionButtons={{this.actionButtons}}
        @bulkActions={{this.bulkActions}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="calendar-check"
            title=(t "fleet-ops.ui.route.maintenance-schedules-index.create-your-first-maintenance-schedule")
            description=(t "fleet-ops.ui.route.maintenance-schedules-index.schedules-help-automate-preventive-work-and")
            filteredTitle=(t "fleet-ops.ui.route.maintenance-schedules-index.no-maintenance-schedules-match-your-filters")
            filteredDescription=(t "fleet-ops.ui.route.maintenance-schedules-index.adjust-the-search-or-filters-to")
            primaryText=(t "fleet-ops.ui.route.maintenance-schedules-index.new-schedule")
            primaryIcon="plus"
            primaryAction=this.maintenanceScheduleActions.transition.create
            secondaryText=(t "fleet-ops.ui.route.maintenance-schedules-index.import")
            secondaryIcon="upload"
            secondaryAction=this.maintenanceScheduleActions.import
            docsSlug="fleet-ops/maintenance/schedules/overview"
            docsTitle=(t "fleet-ops.ui.route.maintenance-schedules-index.schedules-guide")
            docsText=(t "fleet-ops.ui.route.maintenance-schedules-index.schedules-guide")
            docsSource="fleet-ops-empty-maintenance-schedules"
        }}
    />
{{/if}}
{{outlet}}
