<Layout::Resource::Tabular
    @resource="service-rate"
    @title={{t "resource.service-rates"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.serviceRateActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="route"
        title=(t "fleet-ops.ui.route.operations-service-rates-index.set-up-your-first-service-rate")
        description=(t "fleet-ops.ui.route.operations-service-rates-index.service-rates-define-how-fleet-ops")
        filteredTitle=(t "fleet-ops.ui.route.operations-service-rates-index.no-service-rates-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.operations-service-rates-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.operations-service-rates-index.new-service-rate")
        primaryIcon="plus"
        primaryAction=this.serviceRateActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.operations-service-rates-index.refresh")
        secondaryIcon="refresh"
        secondaryAction=this.serviceRateActions.refresh
        docsSlug="fleet-ops/operations/service-rates/overview"
        docsTitle=(t "fleet-ops.ui.route.operations-service-rates-index.service-rates-guide")
        docsText=(t "fleet-ops.ui.route.operations-service-rates-index.service-rates-guide")
        docsSource="fleet-ops-empty-service-rates"
    }}
/>
{{outlet}}
