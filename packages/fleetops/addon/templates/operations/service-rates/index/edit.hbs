<Layout::Resource::Panel
    @resource={{@model}}
    @controller={{this}}
    @headerTitle={{concat (t "fleet-ops.ui.route.operations-service-rates-index-edit.edit") @model.service_name}}
    @actionButtons={{this.actionButtons}}
    @saveTask={{this.save}}
    @onPressCancel={{this.cancel}}
    @onOverlayReady={{fn (mut this.overlay)}}
     @maxResizeWidth={{1000}}
>
    <ServiceRate::Form @resource={{@model}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>