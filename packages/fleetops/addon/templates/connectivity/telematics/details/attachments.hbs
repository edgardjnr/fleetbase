<div class="flex flex-col gap-4 p-4 md:p-6">
    <section class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="border-b border-gray-200 px-4 py-3 dark:border-gray-700">
            <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
                <div class="min-w-0">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.attachment-workspace"}}</h3>
                    <p class="mt-1 truncate text-xs text-gray-500 dark:text-gray-300">
                        {{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.loaded-of-synced-devices" length=this.syncedDevices.length totalSyncedDevices=this.totalSyncedDevices}}
                    </p>
                </div>
                <div class="flex w-full min-w-0 items-start gap-2 xl:max-w-4xl">
                    <div class="grid min-w-0 flex-1 grid-cols-1 gap-2 sm:grid-cols-3">
                        <Input
                            @value={{this.query}}
                            @type="text"
                            class="form-input form-input-sm h-10 w-full text-sm"
                        placeholder={{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.search-assets-or-devices"}}
                            {{on "input" this.updateQuery}}
                        />
                        <select class="form-select form-select-sm h-10 w-full text-sm" {{on "change" this.updateStatus}}>
                            <option value="" selected={{not this.status}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.any-status"}}</option>
                            <option value="active" selected={{eq this.status "active"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.active"}}</option>
                            <option value="online" selected={{eq this.status "online"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.online"}}</option>
                            <option value="recently_offline" selected={{eq this.status "recently_offline"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.recently-offline"}}</option>
                            <option value="offline" selected={{eq this.status "offline"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.offline"}}</option>
                            <option value="long_offline" selected={{eq this.status "long_offline"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.long-offline"}}</option>
                            <option value="never_connected" selected={{eq this.status "never_connected"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.never-connected"}}</option>
                            <option value="inactive" selected={{eq this.status "inactive"}}>{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.inactive"}}</option>
                        </select>
                        <div class="min-w-0">
                            <ModelSelect
                                @modelName="vehicle"
                                @query={{hash telematic_uuid=this.telematic.id}}
                                @selectedModel={{this.selectedVehicle}}
                                @placeholder={{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.any-vehicle"}}
                                @triggerClass="fleetops-attachments-vehicle-filter-trigger form-select form-select-sm h-10 w-full text-sm"
                                @infiniteScroll={{false}}
                                @renderInPlace={{false}}
                                @allowClear={{true}}
                                @onChange={{this.updateSelectedVehicle}}
                                as |vehicle|
                            >
                                {{vehicle.displayName}}
                            </ModelSelect>
                        </div>
                    </div>
                    <Button @icon="refresh" @size="xs" @isLoading={{this.isRefreshing}} @disabled={{this.isRefreshing}} @onClick={{this.refresh}} />
                </div>
            </div>
        </div>

        {{#if (or (eq this.emptyStateVariant "error") (eq this.emptyStateVariant "not_synced") (eq this.emptyStateVariant "filtered_empty"))}}
            <div class="p-4">
                <Telematic::TabEmptyState
                    @tone={{this.emptyStateContent.tone}}
                    @icon={{this.emptyStateContent.icon}}
                    @title={{this.emptyStateContent.title}}
                    @message={{this.emptyStateContent.message}}
                    @note={{this.emptyStateContent.note}}
                    @primaryText={{this.emptyStateContent.primaryText}}
                    @primaryIcon={{this.emptyStateContent.primaryIcon}}
                    @primaryAction={{this.emptyStateContent.primaryAction}}
                    @secondaryText={{this.emptyStateContent.secondaryText}}
                    @secondaryIcon={{this.emptyStateContent.secondaryIcon}}
                    @secondaryAction={{this.emptyStateContent.secondaryAction}}
                />
            </div>
        {{else}}
            <div class="grid grid-cols-1 divide-y divide-gray-200 dark:divide-gray-700 md:grid-cols-2 md:divide-x md:divide-y-0">
                <div class="min-w-0 bg-gray-50/70 dark:bg-gray-900/20">
                    <div class="sticky top-0 z-10 border-b border-gray-200 bg-gray-50/95 px-4 py-3 backdrop-blur dark:border-gray-700 dark:bg-gray-800/95">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.unattached"}}</h4>
                                    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.devices" filteredUnattachedCount=this.filteredUnattachedCount}}</span>
                                </div>
                                {{#if this.selectedDevice}}
                                    <p class="mt-1 truncate text-xs text-blue-600 dark:text-blue-300">
                                        {{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.selected-choose-an-asset-on-the" selectedDeviceName=this.selectedDeviceName}}
                                    </p>
                                {{else}}
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.select-a-device-then-choose-a"}}</p>
                                {{/if}}
                            </div>
                            {{#if this.selectedDevice}}
                                <Button @icon="times" @size="xs" @onClick={{this.clearSelectedDevice}} />
                            {{/if}}
                        </div>
                    </div>

                    <div class="h-[calc(100vh-24rem)] min-h-[28rem] overflow-y-auto">
                        {{#if this.unattachedDevices.length}}
                            <div class="divide-y divide-gray-200 dark:divide-gray-700">
                                {{#each this.unattachedDevices as |device|}}
                                    <div
                                        class="group flex min-h-[56px] cursor-pointer items-center gap-3 border-l-2 px-3 py-2 transition {{if
                                            (eq this.selectedDevice device)
                                            "border-blue-500 bg-blue-50 dark:bg-blue-900/20"
                                            "border-transparent bg-white hover:border-blue-300 hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700/50"
                                        }}"
                                        {{on "click" (fn this.selectUnattachedDevice device)}}
                                    >
                                        <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md bg-gray-100 text-gray-500 dark:bg-gray-700 dark:text-gray-300">
                                            <FaIcon @icon="microchip" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex min-w-0 items-center gap-2">
                                                <span class="truncate text-sm font-semibold text-gray-900 dark:text-gray-100">{{or device.displayName device.name device.device_id}}</span>
                                                <Badge
                                                    @status={{or device.connection_status device.status "default"}}
                                                    @hideIcon={{true}}
                                                    @wrapperClass="text-[9px] px-1 py-0 leading-tight flex-shrink-0"
                                                >
                                                    {{smart-humanize (or device.connection_status device.status "unknown")}}
                                                </Badge>
                                            </div>
                                            <div class="mt-0.5 flex min-w-0 items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                                                <span class="truncate">{{or device.public_id device.device_id device.serial_number device.imei device.id}}</span>
                                            </div>
                                        </div>
                                        <div class="flex flex-shrink-0 items-center gap-1">
                                            <Button @icon="eye" @size="xs" @onClick={{fn this.deviceActions.transition.view device}} />
                                            {{#if (eq this.selectedDevice device)}}
                                                <Button @icon="link" @text={{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.attach"}} @size="xs" @type="primary" @onClick={{fn this.openAttachDeviceModal device}} />
                                            {{else}}
                                                <Button @icon="link" @size="xs" @type="default" @onClick={{fn this.openAttachDeviceModal device}} />
                                            {{/if}}
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        {{else}}
                            <div class="p-4">
                                <div class="rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800 dark:border-green-700 dark:bg-green-900/20 dark:text-green-300">
                                    {{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.all-visible-synced-devices-are-mapped"}}
                                </div>
                            </div>
                        {{/if}}
                    </div>
                </div>

                <div class="min-w-0">
                    <div class="sticky top-0 z-10 border-b border-gray-200 bg-white/95 px-4 py-3 backdrop-blur dark:border-gray-700 dark:bg-gray-800/95">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.assets"}}</h4>
                                    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.mapped" length=this.assetGroups.length}}</span>
                                </div>
                                {{#if this.selectedDevice}}
                                    <p class="mt-1 truncate text-xs text-blue-600 dark:text-blue-300">
                                        {{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.choose-an-asset-for" selectedDeviceName=this.selectedDeviceName}}
                                    </p>
                                {{else}}
                                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.attached-devices-grouped-by-vehicle-or"}}</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <div class="h-[calc(100vh-24rem)] min-h-[28rem] overflow-y-auto">
                        {{#if this.assetGroups.length}}
                            <div class="divide-y divide-gray-200 dark:divide-gray-700">
                                {{#each this.assetGroups as |group|}}
                                    <div class="border-l-2 border-transparent px-4 py-3 transition hover:border-blue-300 hover:bg-blue-50/40 dark:hover:bg-blue-900/10">
                                        <div class="mb-2 flex items-center justify-between gap-3">
                                            <div class="flex min-w-0 items-center gap-3">
                                                <Image
                                                    src={{resource-image (or group.asset.photo_url group.asset.avatar_url) (if (eq group.asset.asset_class "trailer") "trailer" "vehicle")}}
                                                    @fallbackSrc={{(placeholder-image (if (eq group.asset.asset_class "trailer") "trailer" "vehicle"))}}
                                                    alt={{group.name}}
                                                    class="h-10 w-9 flex-shrink-0 rounded-md object-cover"
                                                />
                                                <div class="min-w-0">
                                                    <div class="truncate text-sm font-bold text-gray-900 dark:text-gray-100">{{or group.asset.displayName group.asset.display_name group.asset.name group.name}}</div>
                                                    <div class="mt-0.5 truncate text-xs text-gray-500 dark:text-gray-400">
                                                        {{n-a (or group.asset.plate_number group.asset.internal_id group.asset.call_sign group.asset.vin)}}
                                                        <span class="mx-1">·</span>
                                                        {{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.devices-2" length=group.devices.length}}
                                                    </div>
                                                </div>
                                            </div>
                                            {{#if this.selectedDevice}}
                                                <Button @icon="link" @text={{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.attach-here"}} @size="xs" @type="primary" @onClick={{fn this.attachSelectedDeviceToGroup group}} />
                                            {{/if}}
                                        </div>

                                        <div class="overflow-hidden rounded-md border border-gray-200 dark:border-gray-700">
                                            {{#each group.devices as |device|}}
                                                <div class="flex min-h-[46px] items-center gap-3 border-b border-gray-200 px-3 py-2 last:border-b-0 dark:border-gray-700">
                                                    <div class="min-w-0 flex-1">
                                                        <div class="flex min-w-0 items-center gap-2">
                                                            <span class="truncate text-sm font-semibold text-gray-800 dark:text-gray-100">{{or device.displayName device.name device.device_id}}</span>
                                                            <Badge
                                                                @status={{or device.connection_status device.status "default"}}
                                                                @hideIcon={{true}}
                                                                @wrapperClass="text-[9px] px-1 py-0 leading-tight flex-shrink-0"
                                                            >
                                                                {{smart-humanize (or device.connection_status device.status "unknown")}}
                                                            </Badge>
                                                        </div>
                                                        <div class="mt-0.5 flex min-w-0 items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                                                            <span class="truncate">{{or device.public_id device.device_id device.serial_number device.imei device.id}}</span>
                                                            <span class="h-1 w-1 flex-shrink-0 rounded-full bg-gray-400"></span>
                                                            <span class="flex-shrink-0">{{n-a (format-date-fns device.last_online_at "dd MMM HH:mm")}}</span>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-shrink-0 items-center gap-1">
                                                        <Button @icon="eye" @size="xs" @onClick={{fn this.deviceActions.transition.view device}} />
                                                        <Button @icon="shuffle" @size="xs" @onClick={{fn this.openAttachDeviceModal device}} />
                                                        <Button @icon="unlink" @size="xs" @type="danger" @onClick={{fn this.detachDevice device}} />
                                                    </div>
                                                </div>
                                            {{/each}}
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        {{else}}
                            <div class="p-4">
                                <div class="rounded-md border border-gray-200 bg-gray-50 p-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">
                                    {{t "fleet-ops.ui.route.connectivity-telematics-details-attachments.no-visible-asset-groups-attach-a"}}
                                </div>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </div>
        {{/if}}
    </section>
</div>
