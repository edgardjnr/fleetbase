<div class="flex h-full flex-col bg-gray-50 dark:bg-gray-900">
    <section class="flex-shrink-0 border-b border-gray-200 bg-white px-4 py-4 shadow-sm dark:border-gray-700 dark:bg-gray-900 dark:shadow-sm dark:shadow-black/30 md:px-6">
        <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div class="min-w-0">
                <div class="text-xs font-semibold uppercase text-gray-400 dark:text-gray-500">{{t "fleet-ops.ui.route.connectivity-telematics-edit.connection-settings"}}</div>
                <h1 class="truncate text-lg font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.connectivity-telematics-edit.edit"}} {{or @model.name @model.provider}}</h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-300">{{t "fleet-ops.ui.route.connectivity-telematics-edit.update-credentials-webhook-configuration-and-har"}}</p>
            </div>
            <div class="flex items-center gap-2">
                <Button @icon="plug" @text={{t "fleet-ops.ui.route.connectivity-telematics-edit.test"}} @size="sm" @onClick={{this.openConnectionTestDialog}} />
                <Button @icon="eye" @text={{t "fleet-ops.ui.route.connectivity-telematics-edit.view"}} @size="sm" @onClick={{this.view}} />
                <Button @icon="times" @text={{t "fleet-ops.ui.route.connectivity-telematics-edit.cancel"}} @size="sm" @onClick={{this.cancel}} />
            </div>
        </div>
    </section>

    <Telematic::Settings
        @resource={{@model}}
        @controller={{this}}
        @saveLabel={{t "fleet-ops.ui.route.connectivity-telematics-edit.save-changes"}}
        @savingLabel={{t "fleet-ops.ui.route.connectivity-telematics-edit.saving-changes"}}
        @footerHelp={{t "fleet-ops.ui.route.connectivity-telematics-edit.changes-affect-provider-sync-webhook-ingestion"}}
        @isSaving={{this.save.isRunning}}
        @onCancel={{this.cancel}}
        @onSave={{perform this.save @model}}
    />
</div>
