<div class="flex h-full flex-col bg-gray-50 dark:bg-gray-900">
    <section class="flex-shrink-0 border-b border-gray-200 bg-white px-4 py-4 shadow-sm dark:border-gray-700 dark:bg-gray-900 dark:shadow-sm dark:shadow-black/30 md:px-6">
        <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase text-gray-400 dark:text-gray-500">{{t "fleet-ops.ui.route.connectivity-telematics-new.connectivity-setup"}}</div>
                <h1 class="text-lg font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.connectivity-telematics-new.connect-provider"}}</h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-300">{{t "fleet-ops.ui.route.connectivity-telematics-new.create-a-provider-connection-test-credentials"}}</p>
            </div>
            <Button @icon="times" @text={{t "fleet-ops.ui.route.connectivity-telematics-new.cancel"}} @size="sm" @onClick={{transition-to "connectivity.telematics.index"}} />
        </div>
    </section>

    <Telematic::Form
        @resource={{this.telematic}}
        @controller={{this}}
        @initialProviderKey={{this.setupProvider}}
        @saveLabel={{t "fleet-ops.ui.route.connectivity-telematics-new.create-connection"}}
        @savingLabel={{t "fleet-ops.ui.route.connectivity-telematics-new.creating-connection"}}
        @footerHelp={{t "fleet-ops.ui.route.connectivity-telematics-new.save-the-connection-then-open-it"}}
        @isSaving={{this.save.isRunning}}
        @onCancel={{this.cancel}}
        @onSave={{perform this.save this.telematic}}
    />
</div>
