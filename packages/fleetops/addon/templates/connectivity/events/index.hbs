<Layout::Resource::Tabular
    @resource="device-event"
    @title={{t "fleet-ops.ui.route.connectivity-events-index.connectivity-events"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.deviceEventActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="bolt"
        title=(t "fleet-ops.ui.route.connectivity-events-index.no-connectivity-events-yet")
        description=(t "fleet-ops.ui.route.connectivity-events-index.events-appear-here-after-connected-devices")
        filteredTitle=(t "fleet-ops.ui.route.connectivity-events-index.no-events-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.connectivity-events-index.adjust-the-search-provider-device-or")
        primaryText=(t "fleet-ops.ui.route.connectivity-events-index.refresh")
        primaryIcon="refresh"
        primaryAction=this.deviceEventActions.refresh
        docsSlug="fleet-ops/connectivity/events/overview"
        docsTitle=(t "fleet-ops.ui.route.connectivity-events-index.events-guide")
        docsText=(t "fleet-ops.ui.route.connectivity-events-index.events-guide")
        docsSource="fleet-ops-empty-events"
    }}
/>
{{outlet}}
