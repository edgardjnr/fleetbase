<Layout::Resource::Tabular
    @resource="sensor"
    @title={{t "resource.sensors"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.sensorActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="satellite-dish"
        title=(t "fleet-ops.ui.route.connectivity-sensors-index.add-your-first-sensor")
        description=(t "fleet-ops.ui.route.connectivity-sensors-index.sensors-capture-telemetry-signals-that-can")
        filteredTitle=(t "fleet-ops.ui.route.connectivity-sensors-index.no-sensors-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.connectivity-sensors-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.connectivity-sensors-index.new-sensor")
        primaryIcon="plus"
        primaryAction=this.sensorActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.connectivity-sensors-index.import")
        secondaryIcon="upload"
        secondaryAction=this.sensorActions.import
        docsSlug="fleet-ops/connectivity/sensors/overview"
        docsTitle=(t "fleet-ops.ui.route.connectivity-sensors-index.sensors-guide")
        docsText=(t "fleet-ops.ui.route.connectivity-sensors-index.sensors-guide")
        docsSource="fleet-ops-empty-sensors"
    }}
/>
{{outlet}}
