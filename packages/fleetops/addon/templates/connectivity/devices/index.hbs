<Layout::Resource::Tabular
    @resource="device"
    @title={{t "resource.devices"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.deviceActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="tablet-screen-button"
        title=(t "fleet-ops.ui.route.connectivity-devices-index.add-your-first-device")
        description=(t "fleet-ops.ui.route.connectivity-devices-index.devices-connect-vehicles-and-assets-to")
        filteredTitle=(t "fleet-ops.ui.route.connectivity-devices-index.no-devices-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.connectivity-devices-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.connectivity-devices-index.new-device")
        primaryIcon="plus"
        primaryAction=this.deviceActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.connectivity-devices-index.import")
        secondaryIcon="upload"
        secondaryAction=this.deviceActions.import
        docsSlug="fleet-ops/connectivity/devices/overview"
        docsTitle=(t "fleet-ops.ui.route.connectivity-devices-index.devices-guide")
        docsText=(t "fleet-ops.ui.route.connectivity-devices-index.device-guide")
        docsSource="fleet-ops-empty-devices"
    }}
/>
{{outlet}}
