<Layout::Resource::Panel
    @resource={{@model}}
    @controller={{this}}
    @headerTitle={{concat (t "fleet-ops.ui.route.connectivity-devices-index-edit.edit") (or @model.name @model.serial_number)}}
    @actionButtons={{this.actionButtons}}
    @saveTask={{this.save}}
    @onPressCancel={{this.cancel}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <Device::Form @resource={{@model}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>