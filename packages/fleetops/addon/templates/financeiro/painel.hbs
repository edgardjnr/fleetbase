<Layout::Section::Header @title={{t "fleet-ops.ui.financeiro.painel.titulo"}}>
    <div class="flex items-center space-x-2">
        <Button @icon="refresh" @size="sm" @helpText={{t "common.reload"}} @isLoading={{this.carregar.isRunning}} @onClick={{perform this.carregar}} />
    </div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="max-w-6xl mx-auto px-4 py-6 space-y-5">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <LinkTo @route="financeiro.motoboys" class="block rounded-lg border border-gray-200 dark:border-gray-700 p-4 hover:bg-gray-50 dark:hover:bg-gray-800">
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.a-pagar"}}</div>
                <div class="text-2xl font-semibold text-green-700 dark:text-green-400">{{this.valor this.painel.a_pagar}}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.a-pagar-ajuda"}}</div>
            </LinkTo>
            <LinkTo @route="financeiro.motoboys" class="block rounded-lg border border-gray-200 dark:border-gray-700 p-4 hover:bg-gray-50 dark:hover:bg-gray-800">
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.adiantado"}}</div>
                <div class="text-2xl font-semibold dark:text-white">{{this.valor this.painel.adiantado}}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.adiantado-ajuda"}}</div>
            </LinkTo>
            <LinkTo @route="financeiro.lojas" class="block rounded-lg border border-gray-200 dark:border-gray-700 p-4 hover:bg-gray-50 dark:hover:bg-gray-800">
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.a-receber"}}</div>
                <div class="text-2xl font-semibold dark:text-white">{{this.valor this.painel.a_receber}}</div>
                {{#if this.painel.vencido}}
                    <div class="text-xs font-semibold text-red-600 dark:text-red-400">{{t "fleet-ops.ui.financeiro.painel.vencido" valor=(this.valor this.painel.vencido)}}</div>
                {{else}}
                    <div class="text-xs text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.nada-vencido"}}</div>
                {{/if}}
            </LinkTo>
            <LinkTo @route="financeiro.lojas" class="block rounded-lg border border-gray-200 dark:border-gray-700 p-4 hover:bg-gray-50 dark:hover:bg-gray-800">
                <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.nao-faturado"}}</div>
                <div class="text-2xl font-semibold dark:text-white">{{this.valor this.painel.nao_faturado}}</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.nao-faturado-ajuda"}}</div>
            </LinkTo>
        </div>

        <ContentPanel @title={{t "fleet-ops.ui.financeiro.painel.margem-titulo"}} @open={{true}} @wrapperClass="bordered-classic">
            <div class="flex flex-wrap items-end gap-4 mb-4">
                <InputGroup @name={{t "fleet-ops.ui.financeiro.periodo.inicio"}} @wrapperClass="mb-0">
                    <input type="date" class="form-input form-input-sm" value={{this.inicio}} max={{this.fim}} {{on "change" (fn this.setData "inicio")}} />
                </InputGroup>
                <InputGroup @name={{t "fleet-ops.ui.financeiro.periodo.fim"}} @wrapperClass="mb-0">
                    <input type="date" class="form-input form-input-sm" value={{this.fim}} min={{this.inicio}} {{on "change" (fn this.setData "fim")}} />
                </InputGroup>
                <Button @type="primary" @size="sm" @icon="magnifying-glass" @text={{t "fleet-ops.ui.financeiro.periodo.aplicar"}} @isLoading={{this.carregar.isRunning}} @onClick={{perform this.carregar}} />
                <div class="flex items-center gap-2">
                    <Button @size="xs" @text={{t "fleet-ops.ui.financeiro.periodo.ultimos-7-dias"}} @onClick={{fn this.setPeriodo "last-7-days"}} />
                    <Button @size="xs" @text={{t "fleet-ops.ui.financeiro.periodo.este-mes"}} @onClick={{fn this.setPeriodo "this-month"}} />
                    <Button @size="xs" @text={{t "fleet-ops.ui.financeiro.periodo.mes-passado"}} @onClick={{fn this.setPeriodo "last-month"}} />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
                    <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.cobrado"}}</div>
                    <div class="text-2xl font-semibold dark:text-white">{{this.valor this.periodo.cobrado}}</div>
                </div>
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
                    <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.pago-motoboys"}}</div>
                    <div class="text-2xl font-semibold dark:text-white">{{this.valor this.periodo.pago_motoboys}}</div>
                </div>
                <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
                    <div class="text-xs uppercase text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.margem"}}</div>
                    <div class="text-2xl font-semibold {{if (lt this.periodo.margem 0) 'text-red-600 dark:text-red-400' 'text-green-700 dark:text-green-400'}}">{{this.valor this.periodo.margem}}</div>
                </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">{{t "fleet-ops.ui.financeiro.painel.margem-ajuda"}}</p>
        </ContentPanel>

        <ContentPanel @title={{t "fleet-ops.ui.financeiro.painel.atencao-titulo"}} @open={{true}} @wrapperClass="bordered-classic">
            {{#if this.atencao.length}}
                <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                    {{#each this.atencao as |item|}}
                        <li class="py-2 flex items-center gap-3 text-sm dark:text-gray-100">
                            <FaIcon @icon={{item.icone}} @fixedWidth={{true}} class={{item.cor}} />
                            <LinkTo @route={{item.rota}} @model={{item.modelo}} class="text-blue-600 dark:text-blue-400 hover:underline">
                                {{t item.chave numero=item.params.numero loja=item.params.loja valor=item.params.valor vencimento=item.params.vencimento}}
                            </LinkTo>
                        </li>
                    {{/each}}
                </ul>
            {{else if this.carregar.isRunning}}
                <Spinner />
            {{else}}
                <p class="text-sm text-gray-500 dark:text-gray-400">{{t "fleet-ops.ui.financeiro.painel.nada-pede-atencao"}}</p>
            {{/if}}
        </ContentPanel>
    </div>
    <Spacer @height="300px" />
</Layout::Section::Body>
