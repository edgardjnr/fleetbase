<Layout::Resource::Tabular
    @resource="integrated-vendor"
    @title={{t "resource.integrated-vendors"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.integratedVendorActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="plug"
        title=(t "fleet-ops.ui.route.management-vendors-integrated.no-integrated-vendors-yet")
        description=(t "fleet-ops.ui.route.management-vendors-integrated.integrated-vendor-records-appear-here-after")
        filteredTitle=(t "fleet-ops.ui.route.management-vendors-integrated.no-integrated-vendors-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.management-vendors-integrated.adjust-the-search-or-filters-to")
        docsSlug="fleet-ops/resources/vendors/integrated-vendors"
        docsTitle=(t "fleet-ops.ui.route.management-vendors-integrated.integrated-vendors-guide")
        docsText=(t "fleet-ops.ui.route.management-vendors-integrated.integrated-vendors-guide")
        docsSource="fleet-ops-empty-integrated-vendors"
    }}
/>
{{outlet}}
