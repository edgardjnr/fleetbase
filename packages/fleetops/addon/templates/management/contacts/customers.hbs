{{#if (eq this.layout "table")}}
    <Layout::Resource::Tabular
        @resource="contact"
        @title={{t "resource.customers"}}
        @searchQuery={{this.query}}
        @onSearch={{perform this.customerActions.controllerSearchTask this}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        @setupTable={{fn (mut this.table)}}
        @actionButtons={{this.actionButtons}}
        @bulkActions={{this.bulkActions}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="user-group"
            title=(t "fleet-ops.ui.route.management-contacts-customers.add-your-first-customer")
            description=(t "fleet-ops.ui.route.management-contacts-customers.customers-give-orders-an-owner-contact")
            filteredTitle=(t "fleet-ops.ui.route.management-contacts-customers.no-customers-match-your-filters")
            filteredDescription=(t "fleet-ops.ui.route.management-contacts-customers.adjust-the-search-or-filters-to")
            primaryText=(t "fleet-ops.ui.route.management-contacts-customers.new-customer")
            primaryIcon="plus"
            primaryAction=this.customerActions.transition.create
            secondaryText=(t "fleet-ops.ui.route.management-contacts-customers.import")
            secondaryIcon="upload"
            secondaryAction=this.customerActions.import
        }}
        @withoutHeader={{true}}
    />
{{else}}
    <Layout::Section::Body class="overflow-y-scroll-i h-full">
        <Layout::Resource::CardsGrid
            @resource="contact"
            @data={{@model}}
            @columns="4"
            @showPagination={{true}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @paginationMeta={{@model.meta}}
            @containerClass="p-4"
            class="h-full"
            as |Item|
        >
            <Contact::Card @resource={{Item.model}} @resourceActions={{this.customerActions}} @placeholderType="customer" />
        </Layout::Resource::CardsGrid>
    </Layout::Section::Body>
{{/if}}
{{outlet}}
