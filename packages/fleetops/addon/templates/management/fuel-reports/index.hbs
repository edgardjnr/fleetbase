<Layout::Resource::Tabular
    @resource="fuel-report"
    @title={{t "resource.fuel-reports"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.fuelReportActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="gas-pump"
        title=(t "fleet-ops.ui.route.management-fuel-reports-index.no-fuel-reports-yet")
        description=(t "fleet-ops.ui.route.management-fuel-reports-index.create-fuel-reports-to-track-vehicle")
        filteredTitle=(t "fleet-ops.ui.route.management-fuel-reports-index.no-fuel-reports-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.management-fuel-reports-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.management-fuel-reports-index.new-fuel-report")
        primaryIcon="plus"
        primaryAction=this.fuelReportActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.management-fuel-reports-index.import")
        secondaryIcon="upload"
        secondaryAction=this.fuelReportActions.import
        docsSlug="fleet-ops/resources/fuel-reports/overview"
        docsTitle=(t "fleet-ops.ui.route.management-fuel-reports-index.fuel-reports-guide")
        docsText=(t "fleet-ops.ui.route.management-fuel-reports-index.fuel-reports-guide")
        docsSource="fleet-ops-empty-fuel-reports"
    }}
/>
{{outlet}}
