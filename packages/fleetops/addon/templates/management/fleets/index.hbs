<Layout::Resource::Tabular
    @resource="fleet"
    @title={{t "resource.fleets"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.fleetActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="layer-group"
        title=(t "fleet-ops.ui.route.management-fleets-index.create-your-first-fleet")
        description=(t "fleet-ops.ui.route.management-fleets-index.fleets-help-group-vehicles-and-drivers")
        filteredTitle=(t "fleet-ops.ui.route.management-fleets-index.no-fleets-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.management-fleets-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.management-fleets-index.new-fleet")
        primaryIcon="plus"
        primaryAction=this.fleetActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.management-fleets-index.import")
        secondaryIcon="upload"
        secondaryAction=this.fleetActions.import
        docsSlug="fleet-ops/resources/fleets/overview"
        docsTitle=(t "fleet-ops.ui.route.management-fleets-index.fleets-guide")
        docsText=(t "fleet-ops.ui.route.management-fleets-index.fleet-guide")
        docsSource="fleet-ops-empty-fleets"
    }}
/>
{{outlet}}
