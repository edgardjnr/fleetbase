<Layout::Resource::Tabular
    @resource="place"
    @title={{t "resource.places"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.placeActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="location-dot"
        title=(t "fleet-ops.ui.route.management-places-index.add-your-first-place")
        description=(t "fleet-ops.ui.route.management-places-index.places-keep-frequent-pickup-dropoff-facility")
        filteredTitle=(t "fleet-ops.ui.route.management-places-index.no-places-match-your-filters")
        filteredDescription=(t "fleet-ops.ui.route.management-places-index.adjust-the-search-or-filters-to")
        primaryText=(t "fleet-ops.ui.route.management-places-index.new-place")
        primaryIcon="plus"
        primaryAction=this.placeActions.transition.create
        secondaryText=(t "fleet-ops.ui.route.management-places-index.import")
        secondaryIcon="upload"
        secondaryAction=this.placeActions.import
        docsSlug="fleet-ops/resources/places/overview"
        docsTitle=(t "fleet-ops.ui.route.management-places-index.places-guide")
        docsText=(t "fleet-ops.ui.route.management-places-index.places-guide")
        docsSource="fleet-ops-empty-places"
    }}
/>
{{outlet}}
