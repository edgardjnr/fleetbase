<Layout::Resource::Panel
    @resource={{this.driver}}
    @controller={{this}}
    @actionButtons={{this.actionButtons}}
    @headerTitle={{t "fleet-ops.ui.route.management-drivers-index-new.create-a-new-driver"}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "management.drivers.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <Driver::Form @resource={{this.driver}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>