{{#if (eq this.layout "table")}}
    <Layout::Resource::Tabular
        @resource="driver"
        @title={{t "resource.drivers"}}
        @searchQuery={{this.query}}
        @onSearch={{perform this.driverActions.controllerSearchTask this}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        @setupTable={{fn (mut this.table)}}
        @actionButtons={{this.actionButtons}}
        @bulkActions={{this.bulkActions}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="id-card"
            title=(t "fleet-ops.ui.route.management-drivers-index.add-your-first-driver")
            description=(t "fleet-ops.ui.route.management-drivers-index.drivers-power-dispatching-live-fleet-visibility")
            filteredTitle=(t "fleet-ops.ui.route.management-drivers-index.no-drivers-match-your-search")
            filteredDescription=(t "fleet-ops.ui.route.management-drivers-index.adjust-the-search-or-filters-to")
            primaryText=(t "fleet-ops.ui.route.management-drivers-index.new-driver")
            primaryIcon="plus"
            primaryAction=this.driverActions.transition.create
            secondaryText=(t "fleet-ops.ui.route.management-drivers-index.import")
            secondaryIcon="upload"
            secondaryAction=this.driverActions.import
            docsSlug="fleet-ops/resources/drivers/overview"
            docsTitle=(t "fleet-ops.ui.route.management-drivers-index.drivers-guide")
            docsText=(t "fleet-ops.ui.route.management-drivers-index.driver-guide")
            docsSource="fleet-ops-empty-drivers"
        }}
    />
{{else}}
    <Layout::Section::Header @title={{t "resource.drivers"}} @actionsWrapperClass="space-x-1">
        <Layout::Resource::TabularActions
            @searchQuery={{this.query}}
            @onSearch={{perform this.driverActions.controllerSearchTask this}}
            @columns={{this.columns}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @setupTable={{fn (mut this.table)}}
            @actionButtons={{this.actionButtons}}
            @bulkActions={{this.bulkActions}}
            @controller={{this}}
            @hideColumnsPicker={{true}}
        />
    </Layout::Section::Header>

    <Layout::Section::Body class="overflow-y-scroll-i h-full">
        <Layout::Resource::CardsGrid
            @resource="driver"
            @data={{@model}}
            @columns="4"
            @showPagination={{true}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @paginationMeta={{@model.meta}}
            @containerClass="p-4"
            class="h-full"
            as |Item|
        >
            <Driver::Card @resource={{Item.model}} />
        </Layout::Resource::CardsGrid>
    </Layout::Section::Body>
{{/if}}
{{outlet}}