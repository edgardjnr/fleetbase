<div class="flex h-full flex-col bg-gray-50 dark:bg-gray-900">
    <section class="flex-shrink-0 border-b border-gray-200 bg-white px-4 py-4 shadow-sm dark:border-gray-700 dark:bg-gray-900 md:px-6">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div class="min-w-0">
                <div class="text-xs font-semibold uppercase text-gray-400 dark:text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.fuel-transaction-review"}}</div>
                <h1 class="truncate text-lg font-bold text-gray-900 dark:text-gray-100">{{@model.provider_transaction_id}}</h1>
                <div class="mt-2 flex flex-wrap gap-2 text-xs text-gray-500 dark:text-gray-300">
                    <Badge @status={{@model.sync_status}}>{{@model.sync_status}}</Badge>
                    <span>{{@model.provider}}</span>
                    <span>{{n-a (format-date-fns @model.transaction_at "dd MMM yyyy HH:mm")}}</span>
                    <span>{{n-a @model.station_name}}</span>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <Button @icon="arrow-left" @text={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.back"}} @size="sm" @onClick={{transition-to "management.fuel-transactions.index"}} />
                <Button @icon="rotate" @text={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.reprocess"}} @type="primary" @size="sm" @isLoading={{this.reprocess.isRunning}} @onClick={{perform this.reprocess}} />
            </div>
        </div>
    </section>

    <div class="min-h-0 flex-1 overflow-y-auto p-4 md:p-6">
        <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-4 lg:grid-cols-3">
            <section class="rounded-md border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 lg:col-span-2">
                <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.provider-bill-data"}}</h2>
                <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700"><div class="text-xs text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.vehicle-card"}}</div><div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">{{n-a @model.vehicle_card_id}}</div></div>
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700"><div class="text-xs text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.liters"}}</div><div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">{{n-a @model.volume}}</div></div>
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700"><div class="text-xs text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.amount"}}</div><div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">{{n-a @model.amount}} {{@model.currency}}</div></div>
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700"><div class="text-xs text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.vehicle"}}</div><div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">{{n-a @model.vehicle_name}}</div></div>
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700"><div class="text-xs text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.trip"}}</div><div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">{{n-a @model.trip_number}}</div></div>
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700"><div class="text-xs text-gray-500">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.fuel-report"}}</div><div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">{{n-a @model.fuel_report_id}}</div></div>
                </div>

                <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
                    <div>
                        <h3 class="text-xs font-bold uppercase text-gray-400">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.normalized-payload"}}</h3>
                        <pre class="mt-2 max-h-80 overflow-auto rounded-md bg-gray-900 p-3 text-[11px] leading-5 text-gray-100">{{this.normalizedPayloadJson}}</pre>
                    </div>
                    <div>
                        <h3 class="text-xs font-bold uppercase text-gray-400">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.raw-payload"}}</h3>
                        <pre class="mt-2 max-h-80 overflow-auto rounded-md bg-gray-900 p-3 text-[11px] leading-5 text-gray-100">{{this.rawPayloadJson}}</pre>
                    </div>
                </div>
            </section>

            <aside class="space-y-4">
                <section class="rounded-md border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
                    <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.manual-match"}}</h2>
                    <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-300">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.use-a-fleet-ops-uuid-or"}}</p>
                    <div class="mt-3 space-y-3 no-input-group-padding">
                        <InputGroup @name={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.vehicle-id"}}>
                            <Input class="form-input w-full" @value={{this.vehicleId}} {{on "input" this.setVehicleId}} />
                        </InputGroup>
                        <Button @icon="truck" @text={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.match-vehicle"}} @type="primary" @size="sm" @isLoading={{this.matchVehicle.isRunning}} @disabled={{not this.vehicleId}} @onClick={{perform this.matchVehicle}} />
                        <InputGroup @name={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.order-trip-id"}}>
                            <Input class="form-input w-full" @value={{this.orderId}} {{on "input" this.setOrderId}} />
                        </InputGroup>
                        <Button @icon="route" @text={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.match-order"}} @size="sm" @isLoading={{this.matchOrder.isRunning}} @disabled={{not this.orderId}} @onClick={{perform this.matchOrder}} />
                    </div>
                </section>

                <section class="rounded-md border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
                    <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.review-state"}}</h2>
                    <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-300">{{t "fleet-ops.ui.route.management-fuel-transactions-index-details.mark-noisy-provider-records-as-reviewed"}}</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <Button @icon="check" @text={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.mark-reviewed"}} @size="sm" @isLoading={{this.review.isRunning}} @onClick={{perform this.review "reviewed"}} />
                        <Button @icon="ban" @text={{t "fleet-ops.ui.route.management-fuel-transactions-index-details.ignore"}} @type="danger" @size="sm" @isLoading={{this.review.isRunning}} @onClick={{perform this.review "ignored"}} />
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>
