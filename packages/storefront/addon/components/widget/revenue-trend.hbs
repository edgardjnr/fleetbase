<div class="storefront-dashboard-widget storefront-chart-widget flex h-full flex-col rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="storefront-widget-header">
        <div class="min-w-0">
            <div class="storefront-widget-title">{{t "storefront.ui.widget.revenue-trend"}}</div>
            <div class="storefront-widget-subtitle">{{t "storefront.ui.widget.revenue-across-orders" revenue=this.formattedRevenue count=this.data.summary.orders}}</div>
        </div>
    </div>

    <div class="storefront-chart-body">
        {{#if this.error}}
            <div class="storefront-widget-empty">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="storefront-widget-empty"><Spinner /></div>
        {{else if this.data}}
            <div class="storefront-chart-frame">
                <Chart @type="line" @labels={{this.data.labels}} @datasets={{this.chartDatasets}} @options={{this.chartOptions}} />
            </div>
        {{else}}
            <div class="storefront-widget-empty">{{t "storefront.ui.widget.no-revenue-data"}}</div>
        {{/if}}
    </div>
</div>
