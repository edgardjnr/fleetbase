<div class="storefront-dashboard-widget flex h-full flex-col rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="storefront-widget-header">
        <div>
            <div class="storefront-widget-title">{{t "storefront.ui.widget.customer-insights"}}</div>
            <div class="storefront-widget-subtitle">{{t "storefront.ui.widget.new-vs-returning"}}</div>
        </div>
        <Button @icon="refresh" @size="xs" @onClick={{perform this.load}} />
    </div>

    <div class="storefront-customer-insights-body">
        {{#if this.error}}
            <div class="storefront-widget-empty">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="storefront-widget-empty"><Spinner /></div>
        {{else if this.data}}
            <div class="grid grid-cols-2 gap-2">
                <div class="storefront-mini-stat">
                    <span>{{t "storefront.ui.widget.new"}}</span>
                    <strong>{{this.data.new_customers}}</strong>
                </div>
                <div class="storefront-mini-stat">
                    <span>{{t "storefront.ui.widget.returning"}}</span>
                    <strong>{{this.data.returning_customers}}</strong>
                </div>
            </div>

            <div class="storefront-repeat-rate">
                <div class="mb-2 flex items-center justify-between text-xs">
                    <span class="font-semibold text-gray-600 dark:text-gray-300">{{t "storefront.ui.widget.repeat-rate"}}</span>
                    <span class="font-bold text-gray-900 dark:text-white">{{this.data.repeat_rate}}%</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-700">
                    <div class="h-full rounded-full bg-emerald-500" style={{this.returningPercentStyle}}></div>
                </div>
            </div>

            <div class="storefront-insight-note">
                {{t "storefront.ui.widget.buyers-this-period" count=this.data.total_customers}}
            </div>
        {{else}}
            <div class="storefront-widget-empty">{{t "storefront.ui.widget.no-customer-activity"}}</div>
        {{/if}}
    </div>
</div>
