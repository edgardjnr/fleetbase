<ContentPanel @title={{t "storefront.ui.order.customer-insights"}} @open={{true}} @isLoading={{@isLoading}} @actionButtons={{@actionButtons}} @wrapperClass="bordered-top" ...attributes>
    <div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.customer-type"}}</div>
            <div class="field-value">{{n-a this.customerType}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.storefront-orders"}}</div>
            <div class="field-value">{{n-a this.orderCount}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.customer-id"}}</div>
            <ClickToCopy @value={{this.customer.public_id}} class="field-value">{{n-a this.customer.public_id}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.contact"}}</div>
            <div class="field-value">{{this.contactStatus}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.common.created"}}</div>
            <div class="field-value">{{n-a (format-date-fns this.customer.created_at "d MMM yyyy HH:mm")}}</div>
        </div>
    </div>
</ContentPanel>
