<ContentPanel @title={{t "storefront.common.details"}} @open={{true}} @isLoading={{@isLoading}} @actionButtons={{@actionButtons}} @wrapperClass="bordered-top" ...attributes>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 mb-4 mt-1">
        <div class="field-info-container">
            <div class="field-name">{{t "storefront.common.customer"}}</div>
            <div class="field-value">
                <div class="storefront-order-person storefront-order-person--compact">
                    <Image src={{avatar-url @resource.customer.photo_url}} @fallbackSrc={{config "defaultValues.contactImage"}} class="storefront-order-person__avatar" alt={{@resource.customer.name}} />
                    <div class="min-w-0">
                        <div class="storefront-order-person__name {{unless @resource.customer "text-gray-300"}}">{{n-a @resource.customer.name (t "storefront.ui.order.no-customer")}}</div>
                        <div class="storefront-order-person__meta">{{n-a (or @resource.customer.phone @resource.customer.email) (t "storefront.ui.order.no-contact-details")}}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="field-info-container">
            <div class="field-name">{{t "storefront.common.driver"}}</div>
            <div class="field-value">
                <div class="storefront-order-person storefront-order-person--compact">
                    <Image src={{avatar-url @resource.driver_assigned.photo_url}} @fallbackSrc={{config "defaultValues.driverImage"}} class="storefront-order-person__avatar" alt={{@resource.driver_assigned.name}} />
                    <div class="min-w-0">
                        <div class="storefront-order-person__name {{unless @resource.driver_assigned "text-gray-300"}}">
                            {{n-a (or @resource.driver_assigned.displayName @resource.driver_assigned.name) (t "storefront.ui.order.no-driver-assigned")}}
                        </div>
                        <div class="storefront-order-person__meta">{{n-a @resource.driver_assigned.phone (t "storefront.ui.order.no-phone")}}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.order-id"}}</div>
            <ClickToCopy @value={{@resource.public_id}} class="field-value">{{n-a @resource.public_id}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.common.internal-id"}}</div>
            <ClickToCopy @value={{@resource.internal_id}} class="field-value">{{n-a @resource.internal_id}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.tracking-number"}}</div>
            <ClickToCopy @value={{or @resource.tracking_number.tracking_number @resource.tracking}} class="field-value">{{n-a (or @resource.tracking_number.tracking_number @resource.tracking)}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.order-type"}}</div>
            <div class="field-value">{{n-a (titleize this.orderType)}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.payment-method"}}</div>
            <div class="field-value">{{n-a (titleize this.paymentMethod)}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.order-amount"}}</div>
            <div class="field-value">{{format-currency this.orderAmount this.orderCurrency}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.transaction-id"}}</div>
            <ClickToCopy @value={{this.transactionId}} class="field-value">{{n-a this.transactionId}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.checkout-id"}}</div>
            <ClickToCopy @value={{this.checkoutId}} class="field-value">{{n-a this.checkoutId}}</ClickToCopy>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.common.created"}}</div>
            <div class="field-value">{{n-a @resource.createdAt}}</div>
        </div>
        <div class="field-info-container field-vertical-container dashed-bottom">
            <div class="field-name">{{t "storefront.ui.order.scheduled"}}</div>
            <div class="field-value">{{n-a @resource.scheduledAt}}</div>
        </div>
    </div>
</ContentPanel>
