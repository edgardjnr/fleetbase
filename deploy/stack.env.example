# Variáveis do stack de produção (deploy/docker-stack.yml).
# Copie para deploy/stack.env (ignorado pelo git), preencha e carregue no Portainer.

# --- Domínios (sem https://) ---
CONSOLE_DOMAIN=entregas.restaurantepro.com.br
API_DOMAIN=entregas-api.restaurantepro.com.br
SOCKET_DOMAIN=entregas-socket.restaurantepro.com.br

# Rede overlay externa onde está o cloudflared
PUBLIC_NETWORK=network_public

APP_NAME=Entregas

# --- Segredos (gere valores novos; não reutilize) ---
# APP_KEY:         echo "base64:$(openssl rand -base64 32)"
# DB_ROOT_PASSWORD: openssl rand -hex 24   (só hex, porque vai dentro de uma URL)
APP_KEY=
DB_ROOT_PASSWORD=

# --- E-mail (log = só grava no log; troque para smtp quando tiver servidor) ---
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@restaurantepro.com.br

# --- Opcionais ---
FRONTEND_HOSTS=
FILESYSTEM_DRIVER=public
OSRM_HOST=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_LOCALE=br
IPINFO_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- App do motoboy (Navigator) ---
# Chave pública (flb_live_..., sem aspas) do app. Vazia (padrão) = nada muda. Preenchida, só serve para o login do app e o
# resto da API responde 403 (api/app/Http/Middleware/RestringirChaveDoApp.php). A integração iFood tem de usar OUTRA chave.
# Só ligue com o APK novo (Driver criado do token do motoboy) em TODOS os celulares: o APK atual leva 403 depois do login.
# Trocou a FLEETBASE_KEY do app? Troque esta variável junto, senão a chave nova fica sem restrição e nada avisa.
# Depois de ligar (tem de dar 403): curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer <chave>" https://<API_DOMAIN>/v1/orders
ENTREGAS_CHAVE_APP_MOTOBOY=

# Alarme de pedido novo como push de dados (api/app/Notifications/Entregas/AvisosDoMotoboy.php). Vazio (padrão desde
# 2026-10-04) = ligado: loop e o cartão em tela cheia com Aceitar/Recusar (APK 16+; o cartão com valor e trajeto, APK 22+).
# 0 volta ao push comum (toca uma vez e não acende a tela com o app fechado). No APK 15 ou anterior, tocar no push de dados
# não abre o pedido. Mudou? Update the stack no Portainer ("Re-pull image" desligado). Conferir:
#   docker exec $(docker ps -q -f name=entregas_queue) printenv ENTREGAS_ALARME_POR_DADOS
ENTREGAS_ALARME_POR_DADOS=

# Integração iFood Logistics (api/app/Support/Entregas/Ifood; CLAUDE.md, "Integração iFood"). Vazio = desligada: nada de
# polling, renovação ou despacho de agendados, e a tela Lojas não mostra "Vincular iFood". 1 = ligada (com as duas
# credenciais preenchidas). As credenciais são do app DISTRIBUÍDO no Portal do Desenvolvedor do iFood (Meus Apps →
# Credenciais). Mudou? Update the stack no Portainer ("Re-pull image" desligado) e reinicie a fila e o scheduler:
#   docker service update --force entregas_queue && docker service update --force entregas_scheduler
# Conferir: docker exec $(docker ps -q -f name=entregas_application) printenv ENTREGAS_IFOOD
ENTREGAS_IFOOD=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
